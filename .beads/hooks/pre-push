#!/usr/bin/env bash
set -euo pipefail

# ECC Codex Git Hook: pre-push
#
# Local pre-push hook, shrunk to fast checks. CI is the source of truth
# (see .github/workflows/ci.yml). Earlier revisions re-ran the entire CI
# matrix locally (npm test, build, audit, every lint) on every push, which
# made `ECC_SKIP_PREPUSH=1` a daily escape hatch and trained the team to
# ignore the gate. Heavy work has moved to CI; this hook now does:
#
#   - skip branch-deletion pushes (zero OID)
#   - block re-pushing the exact SHA CI just failed on (gh-aware; soft if
#     gh CLI is missing)
#   - delegate everything else (test, build, lint, docs drift) to CI
#
# Escape hatches:
#   ECC_SKIP_GIT_HOOKS=1   skip all ECC hooks
#   ECC_SKIP_PREPUSH=1     skip just pre-push (alias: CONSTRUCT_SKIP_PREPUSH=1)
# Bypasses on protected branches (main, staging, master) are refused
# unconditionally — those go through PR + CI.

if [[ "${ECC_SKIP_GIT_HOOKS:-0}" == "1" || "${ECC_SKIP_PREPUSH:-0}" == "1" || "${CONSTRUCT_SKIP_PREPUSH:-0}" == "1" ]]; then
  current_branch="$(git branch --show-current 2>/dev/null || echo '')"
  case "$current_branch" in
    main|staging|master)
      printf '[ECC pre-push] SKIP refused on protected branch %s. Open a PR.\n' "$current_branch" >&2
      exit 1
      ;;
  esac
  exit 0
fi

if [[ -f ".ecc-hooks-disable" || -f ".git/ecc-hooks-disable" ]]; then
  exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

# Branch-deletion pushes carry zero OIDs and do not need verification.

is_delete_only=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
    is_delete_only=false
    break
  fi
done
if [[ "$is_delete_only" == "true" ]]; then
  exit 0
fi

# Prior remote CI red-check. Block only when HEAD == the SHA that failed
# (i.e. the developer is about to re-push the exact broken commit). If
# HEAD has moved past it, those new commits may be the fix — print a
# notice and allow. Skipped silently when gh is unavailable.

if command -v gh >/dev/null 2>&1; then
  current_branch="$(git branch --show-current 2>/dev/null || echo '')"
  case "$current_branch" in
    main|master|staging|dev|'') ;;
    *)
      # Use gh's built-in --jq instead of piping through node — keeps the
      # hook portable and avoids shell/JS quoting interactions. Format:
      # "<conclusion> <headSha> <url>" so a single read parses all three.

      run_line="$(gh run list --branch="$current_branch" --limit=1 \
        --json conclusion,headSha,url \
        --jq '.[0] | "\(.conclusion // "") \(.headSha // "") \(.url // "")"' \
        2>/dev/null || echo '')"
      if [[ -n "$run_line" ]]; then
        read -r conclusion run_sha run_url <<<"$run_line"
        if [[ "$conclusion" == "failure" ]]; then
          head_sha="$(git rev-parse HEAD)"
          if [[ -n "$run_sha" && "$head_sha" == "$run_sha" ]]; then
            printf '[ECC pre-push] HEAD (%s) is the commit that failed CI on %s.\n' "${head_sha:0:7}" "$current_branch" >&2
            printf '  Re-pushing the same SHA will fail again. Add a fix commit before pushing.\n' >&2
            printf '  Failed run: %s\n' "$run_url" >&2
            printf '  Override: ECC_SKIP_PREPUSH=1 git push ...\n' >&2
            exit 1
          fi
        fi
      fi
      ;;
  esac
fi

# Everything else (tests, build, lint, docs drift) runs in CI. See
# .github/workflows/ci.yml for the authoritative set.

# --- BEGIN BEADS INTEGRATION v1.0.0 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
    if [ $_bd_exit -eq 124 ]; then
      echo >&2 "beads: hook 'pre-push' timed out after ${_bd_timeout}s — continuing without beads"
      _bd_exit=0
    fi
  else
    bd hooks run pre-push "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-push'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.0.0 ---

exit 0
