# Construct — Environment Variables
# Copy this file to .env and fill in your values

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Required: at least one AI provider API key
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# OpenRouter — required when using OpenRouter models (access 100+ models via one key)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_REFERER=https://your-app.example.com
OPENROUTER_TITLE=Your App Name

# ─── Model Router ─────────────────────────────────────────────────────────────
# Construct auto-discovers free OpenRouter models and falls back on rate limits.
# Run 'construct models --poll' to see what's available now.
# Run 'construct models --apply' to auto-set best free models + sync.
#
# Manual overrides (these win over registry defaults):
# CONSTRUCT_MODEL_REASONING=anthropic/claude-opus-4-6
# CONSTRUCT_MODEL_STANDARD=anthropic/claude-sonnet-4-6
# CONSTRUCT_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
#
# OpenRouter free tier examples (set OPENROUTER_API_KEY to use):
# CONSTRUCT_MODEL_REASONING=openrouter/google/gemini-2.5-pro-exp-03-25:free
# CONSTRUCT_MODEL_STANDARD=openrouter/google/gemini-2.0-flash-exp:free
# CONSTRUCT_MODEL_FAST=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Optional: model tier overrides — set to any provider/model your platform supports
# Anthropic direct:
# CONSTRUCT_MODEL_REASONING=anthropic/claude-opus-4-6
# CONSTRUCT_MODEL_STANDARD=anthropic/claude-sonnet-4-6
# CONSTRUCT_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
# OpenRouter (access 100+ models via one key):
# CONSTRUCT_MODEL_REASONING=openrouter/anthropic/claude-opus-4-6
# CONSTRUCT_MODEL_STANDARD=openrouter/google/gemini-2.5-pro
# CONSTRUCT_MODEL_FAST=openrouter/meta-llama/llama-3.3-70b-instruct
# Ollama (local):
# CONSTRUCT_MODEL_STANDARD=ollama/qwen2.5-coder:32b

# Install path — set automatically by install.sh
# CX_INSTALL_DIR=/path/to/construct

# ─── Cross-Tool Memory (cass/cm) ──────────────────────────────────────────────
# CM_PORT=8765
# The installer can auto-configure local memory or let you skip/manualize it.

# ─── Hybrid Retrieval Backend ─────────────────────────────────────────────────
# `construct init --yes` writes managed defaults automatically. When Docker is
# available, it starts a localhost-only Postgres container on 127.0.0.1:54329.
#
# Shared Postgres store for team-ready state/querying
# DATABASE_URL=postgresql://user:pass@host:5432/construct
# CONSTRUCT_DB_POOL_SIZE=5
# CONSTRUCT_DB_IDLE_TIMEOUT_MS=30000
# CONSTRUCT_DB_CONNECT_TIMEOUT_MS=5000
#
# Data retention: purge documents/embeddings/observations older than N days.
# Applied automatically on each storage_sync. Unset = no purge.
# CONSTRUCT_DATA_RETENTION_DAYS=90
#
# Semantic retrieval index (remote or local)
# CONSTRUCT_VECTOR_URL=https://vector.example.com
# CONSTRUCT_VECTOR_INDEX_PATH=~/.construct/vector/index.json
# CONSTRUCT_VECTOR_MODEL=hashing-bow-v1

# ─── Trace Backend ────────────────────────────────────────────────────────────
# Trace backend configures telemetry export. Set to 'none' to disable.
CONSTRUCT_TRACE_BACKEND=telemetry
# CONSTRUCT_TELEMETRY_URL=https://telemetry.example.com
# CONSTRUCT_TELEMETRY_PUBLIC_KEY=pk-...
# CONSTRUCT_TELEMETRY_SECRET_KEY=sk-...

# ─── Orchestration Web Capability (ADR-0050) ──────────────────────────────────
# A web-capable specialist grants live web access in strict priority order;
# unset both and it degrades to 'unavailable' (honest refusal, never a
# fabricated citation). `construct orchestrate preflight` / `construct doctor`
# surface the resolved mode before any run.
#
# governed: point at Construct's own governed web-search endpoint (preferred —
# preserves ADR-0017 source grading by construction). Wins over every other
# mode when set.
# WEB_SEARCH_URL=https://your-governed-search.example.com
#
# host-delegated: explicit opt-in for a tool-capable host to execute web
# access itself when no provider-native or governed path is configured.
# Evidence is still re-validated fail-closed on ingress.
# CONSTRUCT_ORCHESTRATION_WEB_DELEGATE=1

# ─── Provider Worker Reliability (construct-5wkl) ─────────────────────────────
# The provider worker backend (orchestration.workerBackend: 'provider') calls a
# real model per specialist task. `construct doctor` prints the effective
# values below; see docs/guides/reference/provider-worker-reliability.md for
# the full failure-mode/remediation table.
#
# Per-call timeout in milliseconds. Default 120000 (2 minutes) — a
# conservative floor for LLM completions, which routinely run seconds-to-
# minutes. Raise it for reasoning-heavy models on a slow connection.
# CONSTRUCT_PROVIDER_TIMEOUT_MS=120000
#
# Total attempts per call (1 original + retries), applied only to transient
# outcomes (rate limit, 5xx, timeout) — never to a content-policy refusal or a
# malformed response. Default 3.
# CONSTRUCT_PROVIDER_MAX_ATTEMPTS=3
#
# Base retry backoff in milliseconds; doubles per attempt (250 → 500 → …).
# Default 250.
# CONSTRUCT_PROVIDER_RETRY_BASE_MS=250
