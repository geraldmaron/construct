node_modules/
cache/
coverage/
.nyc_output/
.env
.env.local
construct.config.local.json
*.log
.DS_Store
.claude/
.codex/
.cx/**
.mcp.json

# Generated by `construct sync` (project scope) for each host platform. These
# carry machine-specific absolute paths and are recreated by sync, so they
# stay untracked; the source of truth is `specialists/registry.json` and the
# adapter functions in `scripts/sync-specialists.mjs`.
.opencode/
.cursor/
.vscode/
.github/prompts/
.github/copilot-instructions.md
config.env
embed.yaml
/runtime/

# plan.md is a working session document, not durable repo state. The Construct
# init flow still creates it locally for downstream projects; this rule keeps
# the construct repo itself from accumulating session-specific plan content.
plan.md

# Editor / working backups
*.bak
*.backup
*.orig
*.tmp
*.swp
*.swo
*.new

# MkDocs build output and generated docs tree
site/site/
site/docs/

# Local-only archived release notes and pre-release docs
.archive/

# Playwright MCP snapshots and local screenshots
.playwright-mcp/
dashboard-*.png
*.screenshot.png

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Beads work-tracking data — local-only while Construct is solo. When the
# project moves to a centrally-deployed/multi-person setup, revisit whether
# these should be shared via git.
.beads/issues.jsonl
.beads/metadata.json

# Build artifacts
dashboard/dist/
lib/server/static/

# Local scratch files that occasionally leak into the working tree
.tmp/
token-baseline.txt
# Bun scratch dir (bun/@t@/*.pile) dropped into the repo root by a test runner;
# root-cause fix tracked in beads — until then this keeps it out of git status.
bun/
# Literal `~/` directory created when a script writes to "~/foo" without
# expanding the tilde — never committed.
/~/
skills/roles/*.bak

# Next.js build cache (apps/*/.next) and static export output (apps/*/out)
apps/*/.next/
apps/*/out/

# Tauri desktop window — built via npm run build:chat-desktop
apps/chat/desktop/src-tauri/target/
# Tauri-generated capability schemas — regenerated on build
apps/chat/desktop/src-tauri/gen/
# TypeScript incremental build cache
apps/*/tsconfig.tsbuildinfo

# npm pack output (produced by the consumer-perspective audit gate)
*.tgz

# Python bytecode (docling sidecar compile artifacts)
__pycache__/
*.pyc

# Construct audit harness — regenerated evidence, not source.
audit-artifacts/

# Agentic-hq fixture: full session trace logs are local-only (can grow unbounded).
tests/fixtures/projects/agentic-hq/.cx/traces/*.jsonl
!tests/fixtures/projects/agentic-hq/.cx/traces/sample-traces.jsonl

# Construct — generated adapters, launcher, and runtime state.
# Machine-specific, recreated by `construct sync`; never source (ADR-0027).
.construct/
inbox/
