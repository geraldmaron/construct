node_modules/
dist/
*.tgz
.DS_Store
coverage/

# Per-repo hook health counters, written by scripts/hooks/hook-health.mjs.
.claude/.hook-health.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# construct-2jb.3: generated labeling sheets and real coder responses never
# belong in git — sheets/ is regenerable, returned/ may carry a labeler's name.
scripts/labeling-kit/sheets/
scripts/labeling-kit/returned/*.json

# Agent worktrees: ephemeral per-agent checkouts, auto-cleaned, never committed.
.claude/worktrees/
# Session Typst/PDF dogfood lives next to the checkout, not in the product tree.
tmp/
