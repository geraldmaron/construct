node_modules/
dist/
*.tgz
.DS_Store
coverage/

# Per-repo hook health counters, written by scripts/hooks/hook-health.mjs.
.claude/.hook-health.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# construct-2jb.3: generated labeling sheets and real coder responses never
# belong in git — sheets/ is regenerable, returned/ may carry a labeler's name.
scripts/labeling-kit/sheets/
scripts/labeling-kit/returned/*.json

# Agent worktrees: ephemeral per-agent checkouts, auto-cleaned, never committed.
.claude/worktrees/
# Session Typst/PDF dogfood lives next to the checkout, not in the product tree.
tmp/

# Scratch probe output: a checksum sidecar a backup probe writes beside a
# database it does not keep. It named a file that no longer exists the moment
# the probe ended, so committing one records nothing a reader can check.
__probe__/

# Dotenv files hold live credentials and never belong in git; the example
# template of variable names does.
.env
.env.*
!.env.example

# Local MCP wiring from `construct wire --yes` in other hosts; never committed.
# This checkout's Cursor socket is the committed .cursor/mcp.json — a fresh
# chat loads it at session start. talk() does not write that file.
.mcp.json
.cursor/rules/construct-first-run.mdc
.claude/rules/construct-first-run.md
