node_modules/
dist/
*.tgz
.DS_Store
coverage/

# Per-repo hook health counters, written by scripts/hooks/hook-health.mjs.
.claude/.hook-health.json

# SQLite files outside the state directory (scratch copies, exports)
*.db

# Agent worktrees: ephemeral per-agent checkouts, auto-cleaned, never committed.
.claude/worktrees/
# Session Typst/PDF dogfood lives next to the checkout, not in the product tree.
tmp/

# Dotenv files hold live credentials and never belong in git; the example
# template of variable names does.
.env
.env.*
!.env.example


# Ephemeral test fixtures created inside the workspace (sandbox-safe)
.tmp-*/

# Conformance reports are recorded in the changelog, not committed as files
.tmp-conformance/
# Construct runtime state
.construct/state/
# Protected recovery material (work exports)
.construct/recovery/
# Browser-automation console logs written by the Playwright MCP server
.playwright-mcp/
# Private research and generated records live outside this checkout.
/evals/
/docs/internal/
/STRATEGY.md
/RESEARCH-DECISIONS.md
/HANDOFF.md
/COORDINATION.md

# This repository's dogfooding identity, sources and host wiring are local.
# Public product examples and schemas live under docs/, src/ and tests/.
/.construct/
/.mcp.json
/.claude/
/.codex/
/.agents/
/.bob/
/.cursor/mcp.json
/.vscode/mcp.json
/opencode.json
