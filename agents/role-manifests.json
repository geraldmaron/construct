        "allowedPaths": ["docs/adr/**", "docs/rfc/**", "docs/architecture.md", "docs/system-design/**"],
        "allowedBdLabels": ["architecture", "adr", "rfc", "design"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**", "edit:agents/**"]
