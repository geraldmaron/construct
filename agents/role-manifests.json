      "handoffCandidates": ["engineer", "designer", "qa"],
      "killSwitchEnv": "CONSTRUCT_ROLE_ACCESSIBILITY"
    },
    "reviewer": {
      "events": ["handoff.received", "pr.opened", "pr.ready-for-review"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/reviews/**"],
        "allowedBdLabels": ["review", "code-review", "second-look"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:**"]
      },
      "outputs": { "bdLabels": ["review"], "docTypes": ["memo"] },
      "handoffCandidates": ["engineer", "architect", "security"],
      "killSwitchEnv": "CONSTRUCT_ROLE_REVIEWER"
    },
    "platform-engineer": {
      "events": ["handoff.received", "infra.change.requested", "service.scale.event"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/platform/**", "docs/infra/**", "infra/**", "terraform/**", "k8s/**"],
        "allowedBdLabels": ["platform", "infrastructure", "infra"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**"]
      },
      "outputs": { "bdLabels": ["platform"], "docTypes": ["memo", "runbook"] },
      "handoffCandidates": ["sre", "engineer", "reviewer"],
      "killSwitchEnv": "CONSTRUCT_ROLE_PLATFORM_ENGINEER"
    },
    "data-analyst": { "events": ["handoff.received"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/analytics/**", ".cx/analytics/**"], "allowedBdLabels": ["analytics", "metrics"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**"] }, "outputs": { "bdLabels": ["analytics"], "docTypes": ["memo"] }, "handoffCandidates": ["product-manager", "engineer"], "killSwitchEnv": "CONSTRUCT_ROLE_DATA_ANALYST" },
    "data-engineer": { "events": ["handoff.received"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/data/**", "docs/etl/**"], "allowedBdLabels": ["data", "etl", "pipeline"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**"] }, "outputs": { "bdLabels": ["data"], "docTypes": ["memo"] }, "handoffCandidates": ["engineer", "platform-engineer", "data-analyst"], "killSwitchEnv": "CONSTRUCT_ROLE_DATA_ENGINEER" },
    "evaluator": { "events": ["handoff.received", "eval.regression"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/evals/**", ".cx/evals/**", "tests/evals/**"], "allowedBdLabels": ["eval", "regression-eval"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:**"] }, "outputs": { "bdLabels": ["eval"], "docTypes": ["memo"] }, "handoffCandidates": ["engineer", "ai-engineer"], "killSwitchEnv": "CONSTRUCT_ROLE_EVALUATOR" },
    "trace-reviewer": { "events": ["handoff.received", "trace.anomaly"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/traces/**", ".cx/traces/**"], "allowedBdLabels": ["trace", "observability"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:**"] }, "outputs": { "bdLabels": ["trace"], "docTypes": ["memo"] }, "handoffCandidates": ["sre", "ai-engineer", "engineer"], "killSwitchEnv": "CONSTRUCT_ROLE_TRACE_REVIEWER" },
    "test-automation": { "events": ["handoff.received"], "severityImmediate": [], "fence": { "allowedPaths": ["tests/**", "docs/test-automation/**"], "allowedBdLabels": ["test-automation", "ci", "test-infra"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**"] }, "outputs": { "bdLabels": ["test-automation"], "docTypes": ["memo"] }, "handoffCandidates": ["qa", "engineer", "platform-engineer"], "killSwitchEnv": "CONSTRUCT_ROLE_TEST_AUTOMATION" },
    "ai-engineer": { "events": ["handoff.received"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/ai/**", "docs/agents/**", "agents/**", "skills/ai/**"], "allowedBdLabels": ["ai", "agent", "model"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**"] }, "outputs": { "bdLabels": ["ai"], "docTypes": ["memo"] }, "handoffCandidates": ["engineer", "architect", "evaluator"], "killSwitchEnv": "CONSTRUCT_ROLE_AI_ENGINEER" },
    "business-strategist": { "events": ["handoff.received"], "severityImmediate": [], "fence": { "allowedPaths": ["docs/strategy/**", ".cx/strategy/**"], "allowedBdLabels": ["strategy", "business"], "allowedCommands": ["bd create", "bd note", "bd update"], "approvalRequired": ["commit", "push", "edit:**"] }, "outputs": { "bdLabels": ["strategy"], "docTypes": ["memo"] }, "handoffCandidates": ["product-manager", "researcher"], "killSwitchEnv": "CONSTRUCT_ROLE_BUSINESS_STRATEGIST" },
    "researcher": {
      "events": ["handoff.received", "research.requested", "evidence.requested"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/research/**", ".cx/research/**", "docs/evidence-briefs/**", "docs/signal-briefs/**"],
        "allowedBdLabels": ["research", "evidence", "investigation"],
