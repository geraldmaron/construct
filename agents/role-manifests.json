    "accessibility": {
      "events": ["handoff.received", "a11y.violation"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/accessibility/**", "docs/a11y/**"],
        "allowedBdLabels": ["accessibility", "a11y"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:**"]
