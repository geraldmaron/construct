{
  "$comment": "Role manifests for the Construct-on-Construct role framework. Keyed by registry persona name (without cx- prefix, matching agents/registry.json). Empty entries reserve the slot for future onboarding without code change.",
  "version": 1,
  "personas": {
    "sre": {
      "events": ["push_gate.fail", "service.down", "mcp.unhealthy.persistent", "edit_loop.stuck"],
      "severityImmediate": ["service.down"],
      "fence": {
        "allowedPaths": ["docs/runbooks/**", "docs/incidents/**", "docs/postmortems/**"],
        "allowedBdLabels": ["incident", "sre", "reliability"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd link", "bd label"],
        "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**", "edit:agents/**"]
      },
      "outputs": {
        "bdLabels": ["incident", "sre"],
        "docTypes": ["runbook", "incident-report", "postmortem"]
      },
      "handoffCandidates": ["engineer", "platform-engineer", "debugger"],
      "killSwitchEnv": "CONSTRUCT_ROLE_SRE"
    },
    "qa": {
      "events": ["test.fail", "test.flake", "coverage.drop"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/qa/**", "docs/test-plans/**"],
        "allowedBdLabels": ["bug", "qa", "test", "flake"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:tests/**", "edit:lib/**", "edit:bin/**"]
      },
      "outputs": {
        "bdLabels": ["bug", "qa"],
        "docTypes": ["test-plan", "qa-strategy"]
      },
      "handoffCandidates": ["engineer", "debugger", "test-automation"],
      "killSwitchEnv": "CONSTRUCT_ROLE_QA"
    },
    "security": {
      "events": ["dep.cve", "secrets.detected", "config.protection.violation"],
      "severityImmediate": ["dep.cve", "secrets.detected"],
      "fence": {
        "allowedPaths": ["docs/security/**", "docs/threat-models/**"],
        "allowedBdLabels": ["security", "vulnerability", "audit"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:**"]
      },
      "outputs": {
        "bdLabels": ["security", "vulnerability"],
        "docTypes": ["security-review", "threat-model"]
      },
      "handoffCandidates": ["engineer", "platform-engineer", "reviewer"],
      "killSwitchEnv": "CONSTRUCT_ROLE_SECURITY"
    },
    "docs-keeper": {
      "events": ["pr.merged.no-docs", "changelog.missing", "readme.stale"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["docs/**", "**/README.md", "CHANGELOG.md"],
        "allowedBdLabels": ["docs", "doc-drift", "changelog"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd label"],
        "approvalRequired": ["commit", "push", "edit:lib/**", "edit:bin/**", "edit:agents/**"]
      },
      "outputs": {
        "bdLabels": ["docs", "doc-drift"],
        "docTypes": ["memo", "changelog"]
      },
      "handoffCandidates": ["engineer"],
      "killSwitchEnv": "CONSTRUCT_ROLE_DOCS_KEEPER"
    },
    "engineer": {
      "events": ["handoff.received", "incident.handoff", "bug.assigned", "feature.assigned"],
      "severityImmediate": [],
      "fence": {
        "allowedPaths": ["lib/**", "bin/**", "src/**", "app/**", "tests/**", "docs/**"],
        "allowedBdLabels": ["bug", "feature", "task", "engineering", "fix"],
        "allowedCommands": ["bd create", "bd note", "bd update", "bd link", "bd label", "bd close"],
        "approvalRequired": ["commit", "push", "edit:agents/registry.json", "edit:install.sh", "edit:claude/settings.template.json"]
      },
      "outputs": {
        "bdLabels": ["engineering", "fix"],
        "docTypes": ["memo"]
      },
      "handoffCandidates": ["qa", "reviewer", "security", "sre"],
      "killSwitchEnv": "CONSTRUCT_ROLE_ENGINEER"
    },
    "architect": {
      "events": ["handoff.received", "adr.requested", "arch.boundary.violated"],
