      "outputs": { "bdLabels": ["architecture", "adr"], "docTypes": ["adr", "rfc", "rfc-platform", "architecture-overview", "system-design"] },
      "handoffCandidates": ["engineer", "platform-engineer", "reviewer"],
      "killSwitchEnv": "CONSTRUCT_ROLE_ARCHITECT"
    },
