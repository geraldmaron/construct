  ['drop', async (args) => {
    const { runDropCli } = await import('../lib/drop.mjs');
    return runDropCli(args, { cwd: process.cwd(), env: process.env });
  }],
  ['docs', async (args) => {
    const sub = args[0];
    if (!sub || sub === '--help' || sub === '-h') {
      println('Usage: construct docs <check|verify|update|site>');
      return;
    }
    const rest = args.slice(1);
    if (sub === 'verify') return cmdDocsVerify(rest);
    if (sub === 'update') return cmdDocsUpdate(rest);
    if (sub === 'check') return cmdDocsCheck(rest);
    if (sub === 'site') return cmdDocsSite();
    if (sub === 'reconcile') return cmdDocsReconcile(rest);
    errorln(`Unknown docs subcommand: ${sub}. Available: check, verify, update, site, reconcile`);
    process.exit(1);
  }],
  ['docs:verify', cmdDocsVerify],
  ['docs:reconcile', cmdDocsReconcile],
  ['init:update', cmdInitUpdate],
  ['models', cmdModels],
  ['beads:stats', async (args) => {
    const { getContentionStats, getHumanStatus } = await import('../lib/beads-optimistic.mjs');
    const jsonOutput = args.includes('--json');
    if (args.includes('--health')) {
      process.stdout.write(await getHumanStatus(process.cwd()));
      return;
    }
    const stats = await getContentionStats(process.cwd());
    if (jsonOutput) {
      println(JSON.stringify(stats, null, 2));
    } else {
