  ['infer', cmdInfer],
  ['search', cmdSearch],
  ['storage', cmdStorage],
  ['headhunt', cmdHeadhunt],
  ['init', cmdInit],
  ['docs:verify', cmdDocsVerify],
  ['init:update', cmdInitUpdate],
  ['models', cmdModels],
  ['mcp', cmdMcp],
  ['plugin', cmdPlugin],
  ['hosts', cmdHosts],
  ['review', cmdReview],
  ['optimize', cmdOptimize],
