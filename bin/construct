if (!command || command === '--help' || command === '-h' || command === 'help') {
  usage();
  process.exit(0);
}

const handler = handlers.get(command);
if (!handler) {
  errorln(`Unknown command: ${command}`);
  usage();
  process.exit(1);
}

await handler(rest);
