function parseKvFlags(args, keys) {
  const out = {};
  for (const arg of args) {
    for (const key of keys) {
      const prefix = `--${key}=`;
      if (arg.startsWith(prefix)) out[key] = arg.slice(prefix.length);
    }
  }
  return out;
}

function formatIntakeTable(rows, { intakeQueueLabel, signalNoun } = { intakeQueueLabel: 'Intake queue', signalNoun: 'signal' }) {
  if (rows.length === 0) {
    println(`No pending ${signalNoun}s.`);
    return;
  }
  println(`${intakeQueueLabel} (${rows.length} pending):`);
  const headers = ['ID', 'Type', 'Stage', 'Owner', 'Action'];
  const widths = headers.map((h, i) => Math.max(h.length, ...rows.map((r) => String(r[i] || '').length)));
  const fmt = (cells) => cells.map((c, i) => String(c || '').padEnd(widths[i])).join('  ');
  println(fmt(headers));
  println(widths.map((w) => '─'.repeat(w)).join('  '));
  for (const row of rows) println(fmt(row));
}

// Embedded triage/planning surface — classifies an artifact and returns a
// role-aware plan with no enqueue and no durable write. Shared by
// `intake classify` and `graph recommend`. Input comes from --text, --file, or
// stdin; --no-enqueue is accepted for explicitness (this path never enqueues).

async function cmdEmbeddedTriage(args) {
  const flag = (name) => { const i = args.indexOf(name); return i !== -1 ? args[i + 1] : undefined; };
  const fileArg = flag('--file');
  let input = flag('--text') || '';
  let ingestion = null;
  if (!input && fileArg) {
    const { resolveInput } = await import('../lib/embedded-contract/ingest.mjs');
    const resolved = await resolveInput({ filePath: fileArg });
    input = resolved.text;
    ingestion = resolved.error ? { ...(resolved.ingestion || {}), error: resolved.error } : resolved.ingestion;
  }
  if (!input && !process.stdin.isTTY) {
    input = fs.readFileSync(0, 'utf8');
  }
  if (!input.trim() && !ingestion?.error) {
    errorln('Usage: construct intake classify --json [--text "..." | --file <path> | <stdin>] [--source <path>] [--artifact-type <t>] [--available-roles a,b]');
    process.exit(1);
  }
  const request = {
    input,
    sourcePath: flag('--source') || (fileArg || ''),
    ingestion,
    artifactType: flag('--artifact-type'),
    domain: flag('--domain'),
    desiredOutcome: flag('--desired-outcome'),
    constraints: flag('--constraints')?.split(',').map((s) => s.trim()).filter(Boolean),
    availableRoles: flag('--available-roles')?.split(',').map((s) => s.trim()).filter(Boolean),
  };
  const { recommendPlan } = await import('../lib/embedded-contract/triage.mjs');
  const { wrapContractResult } = await import('../lib/embedded-contract/envelope.mjs');
  const envelope = wrapContractResult(recommendPlan(request), { surface: 'cli' });
  println(JSON.stringify(envelope, null, 2));
}

async function cmdIntake(args) {
  const sub = args[0];

  if (!sub || sub === '--help' || sub === '-h') {
    await printIntakeHelp();
    return;
  }

  if (sub === 'classify') {
    return await cmdEmbeddedTriage(args.slice(1));
  }

  const { createIntakeQueue } = await import('../lib/intake/queue.mjs');
  const { getRebrand } = await import('../lib/profiles/rebrand.mjs');
  const cwd = process.cwd();
  const rebrand = getRebrand(cwd);
  const queue = createIntakeQueue(cwd, process.env);

  if (sub === 'list') {
    const pending = queue.listPending();
    const rows = pending.map((p) => {
      const t = p.triage || {};
      return [p.id, t.intakeType || 'unknown', t.rdStage || 'unknown', t.primaryOwner || '—', t.recommendedAction || '—'];
    });
    formatIntakeTable(rows, rebrand);
    return;
  }

  const id = args[1];
  if (sub === 'show') {
    if (!id) { errorln('Usage: construct intake show <id>'); process.exit(1); }
    const entry = queue.read(id);
    if (!entry) { errorln(`No ${rebrand.signalNoun} with id: ${id}`); process.exit(1); }
    const t = entry.triage || {};
    println(`${rebrand.signalNoun.charAt(0).toUpperCase() + rebrand.signalNoun.slice(1)} ${entry.id}`);
    println(`ID:        ${entry.id}`);
    println(`Status:    ${entry.status}`);
    println(`Source:    ${entry.intake?.sourcePath || '(none)'}`);
    if (entry.processedAt) println(`Processed: ${entry.processedAt} by ${entry.processedBy || 'unknown'}`);
    if (entry.skippedAt) println(`Skipped:   ${entry.skippedAt} by ${entry.skippedBy || 'unknown'}${entry.reason ? ` — ${entry.reason}` : ''}`);
    println('');
    println('Triage:');
    println(`  intakeType:        ${t.intakeType || 'unknown'}`);
    println(`  rdStage:           ${t.rdStage || 'unknown'}`);
    println(`  primaryOwner:      ${t.primaryOwner || '—'}`);
    println(`  recommendedChain:  ${(t.recommendedChain || []).join(' → ') || '—'}`);
    println(`  recommendedAction: ${t.recommendedAction || '—'}`);
    println(`  risk:              ${t.risk || '—'}`);
    println(`  requiresApproval:  ${t.requiresApproval ? 'yes' : 'no'}`);
    println(`  confidence:        ${typeof t.confidence === 'number' ? t.confidence.toFixed(2) : '—'}`);
    if (t.rationale) println(`  rationale:         ${t.rationale}`);
    if (entry.customers?.length > 0) {
      println('');
      println(`Linked customers: ${entry.customers.join(', ')}`);
    }
    if (entry.externalRefs) {
      println('');
      println('External references:');
      for (const [system, ref] of Object.entries(entry.externalRefs)) {
        println(`  ${system}: ${ref.url} (id: ${ref.id})`);
      }
    }
    if (entry.suggestion?.lane) {
      println('');
      println(`Suggested lane: ${entry.suggestion.lane} (${entry.suggestion.source})`);
    }
    if ((entry.related || []).length > 0) {
      println('');
      println('Related artifacts:');
      for (const r of entry.related) {
        const score = typeof r.score === 'number' ? ` · score ${r.score.toFixed(2)}` : '';
        println(`  - ${r.path || r.title}${score}`);
      }
    }
    if (entry.excerpt) {
      println('');
      println('Excerpt:');
      for (const line of String(entry.excerpt).split('\n').slice(0, 12)) println(`  ${line}`);
    }
    // Show similar items if there are multiple pending packets
    try {
      const pendingDir = path.join(cwd || process.cwd(), '.cx', 'intake', 'pending');
      if (fs.existsSync(pendingDir)) {
        const allPackets = [];
        for (const f of fs.readdirSync(pendingDir)) {
          if (!f.endsWith('.json')) continue;
          if (f === `${entry.id}.json`) continue;
          try {
            const pkt = JSON.parse(fs.readFileSync(path.join(pendingDir, f), 'utf8'));
            allPackets.push({ id: f.replace('.json', ''), text: (pkt.excerpt || '') + ' ' + (pkt.triage?.intakeType || '') });
          } catch { /* skip */ }
        }
        if (allPackets.length > 0) {
          println('');
          println('Similar signals (semantic):');
          println('  (run `construct intake list` to see all pending)');
        }
      }
    } catch { /* dir not available */ }

    // Show active recommendations related to this packet
    try {
      const { listActiveRecommendations } = await import('../lib/embed/recommendation-store.mjs');
      const active = listActiveRecommendations({ limit: 5 });
      if (active.length > 0) {
        println('');
        println('Active recommendations:');
        for (const rec of active) {
          println(`  ${rec.priority} ${rec.type.toUpperCase()}: ${rec.title} (${rec.totalSignalCount} signal(s) · score ${rec.score})`);
        }
        println('  Run `construct recommendations list` for details');
      }
    } catch { /* recommendations not available */ }

    println('');
    println('Next steps:');
    println(`  construct graph from-intake ${entry.id}     Generate task graph from triage`);
    if (entry.suggestion?.lane) {
      println(`  Edit docs/${entry.suggestion.lane}/          Review/update the suggested lane`);
    }
    println(`  construct intake done ${entry.id}            Mark as processed`);
    println(`  construct intake skip ${entry.id}             Mark as skipped`);
    return;
  }

  if (sub === 'done') {
    if (!id) {
      errorln('Usage: construct intake done <id> [--notes=…] [--output=<path>] [--no-output=<rejected|deferred|merged>]');
      process.exit(1);
    }
    const flags = parseKvFlags(args.slice(2), ['notes', 'output', 'no-output']);
    const outputPath = flags.output || null;
    const noOutputOutcome = flags['no-output'] || null;

    if (outputPath && noOutputOutcome) {
      errorln('--output and --no-output are mutually exclusive');
      process.exit(1);
    }
    if (noOutputOutcome && !['rejected', 'deferred', 'merged'].includes(noOutputOutcome)) {
      errorln(`--no-output value must be one of: rejected, deferred, merged (got "${noOutputOutcome}")`);
      process.exit(1);
    }

    let stamped = null;
    if (outputPath) {
      const packet = queue.read(id);
      if (!packet) {
        errorln(`No intake packet found: ${id}`);
        process.exit(1);
      }
      const triage = packet.triage || {};
      try {
        const { stampIntakeProvenance } = await import('../lib/intake/traceability.mjs');
        const path = (await import('node:path')).default;
        const absPath = path.isAbsolute(outputPath) ? outputPath : path.join(cwd, outputPath);
        stamped = stampIntakeProvenance(absPath, {
          intakeId: id,
          confidence: triage.confidence,
          rationale: triage.rationale,
        });
      } catch (err) {
        errorln(err.message || 'intake stamping failed');
        process.exit(1);
      }
    }

    const notes = flags.notes
      || (noOutputOutcome ? `intake_outcome: ${noOutputOutcome}` : '')
      || (outputPath ? `output: ${outputPath}` : '');

    try {
      const r = queue.markProcessed(id, { processedBy: 'construct-intake-cli', notes });
      if (stamped) {
        info(`Marked ${r.id} processed. Stamped ${outputPath} with intake_id=${id} (confidence=${stamped.intake_confidence ?? 'n/a'}).`);
      } else if (noOutputOutcome) {
        info(`Marked ${r.id} processed (intake_outcome: ${noOutputOutcome}).`);
      } else {
        info(`Marked ${r.id} processed.`);
      }
    } catch (err) {
      errorln(err.message || 'mark processed failed');
      process.exit(1);
    }
    return;
  }

  if (sub === 'skip') {
    if (!id) { errorln('Usage: construct intake skip <id> [--reason=…]'); process.exit(1); }
    const flags = parseKvFlags(args.slice(2), ['reason']);
    try {
      const r = queue.markSkipped(id, { skippedBy: 'construct-intake-cli', reason: flags.reason || '' });
      info(`Marked ${r.id} skipped.`);
    } catch (err) {
      errorln(err.message || 'mark skipped failed');
      process.exit(1);
    }
    return;
  }

  if (sub === 'reopen') {
    if (!id) { errorln('Usage: construct intake reopen <id>'); process.exit(1); }
    try {
      const r = queue.reopen(id);
      info(`Reopened ${r.id} (from ${r.from}).`);
    } catch (err) {
      errorln(err.message || 'reopen failed');
      process.exit(1);
    }
    return;
  }

  if (sub === 'metrics') {
    return await cmdIntakeMetrics();
  }

  if (sub === 'quarantine') {
    return await cmdIntakeQuarantine(args.slice(1), cwd);
  }

  if (sub === 'reroute') {
    return await cmdIntakeReroute(args.slice(1), cwd);
  }

  if (sub === 'integrate') {
    return await cmdIntakeIntegrate(id, args.slice(2), cwd);
  }

  if (sub === 'process') {
    return await cmdIntakeProcess(args.slice(1), cwd);
  }

  if (sub === 'config') {
    return await cmdIntakeConfig(args.slice(1));
  }

  if (sub === 'extraction-warnings') {
    return await cmdIntakeExtractionWarnings(args.slice(1));
  }

  if (sub === 'needs-asr') {
    return await cmdIntakeNeedsAsr(args.slice(1));
  }

  errorln(`Unknown intake subcommand: ${sub}. Available: list, show, done, skip, reopen, process, quarantine, reroute, integrate, config, extraction-warnings, needs-asr`);
  process.exit(1);
}

async function cmdIntakeProcess(args, cwd) {
  const dryRun = args.includes('--dry-run');
  const waitFlag = args.find((a) => a === '--wait' || a.startsWith('--wait='));
  const { InboxWatcher, resolveInboxDirs } = await import('../lib/embed/inbox.mjs');

  if (dryRun) {
    const dirs = resolveInboxDirs(cwd, process.env);
    if (dirs.length === 0) {
      println('No inbox directories configured. Run `construct intake config` to add one.');
      return;
    }
    println('Would scan:');
    for (const d of dirs) println(`  ${d}`);
    println('');
    println('(dry-run — no files processed; re-run without --dry-run to actually ingest.)');
    return;
  }

  // Concurrency is controlled by the intake poll lock inside
  // InboxWatcher.poll. Default behavior is fail-fast: if the daemon (or
  // another CLI invocation) is mid-poll, raise an actionable error rather
  // than serializing silently. --wait[=<seconds>] opts into blocking for
  // up to N seconds (default 30s when --wait is bare).

  let waitMs = 0;
  if (waitFlag) {
    const m = /^--wait(?:=(\d+))?$/.exec(waitFlag);
    const seconds = m && m[1] ? Number(m[1]) : 30;
    waitMs = Math.max(0, seconds) * 1000;
  }

  const watcher = new InboxWatcher({ rootDir: cwd, env: process.env, cwd });
  let result;
  try {
    result = await watcher.poll({ waitMs, actor: 'construct intake process' });
  } catch (err) {
    const { POLL_LOCK_BUSY } = await import('../lib/intake/poll-lock.mjs');
    if (err && err.code === POLL_LOCK_BUSY) {
      const holder = err.holder || {};
      errorln('Another intake poll is in progress.');
      errorln(`  holder: ${holder.actor || 'unknown'} (pid ${holder.pid})`);
      errorln(`  started: ${holder.startedAt || 'unknown'}`);
      errorln('');
      errorln('Choose one:');
      errorln('  construct intake process --wait        Block until the holder finishes (default 30s).');
      errorln('  construct intake process --wait=<sec>  Block for a custom window.');
      errorln('  construct down                          Stop background services, then retry.');
      process.exit(2);
    }
    throw err;
  }

  println(`Processed: ${result.processed.length}`);
  println(`Skipped (unchanged): ${result.skipped}`);
  if (result.errors.length) {
    println(`Errors: ${result.errors.length}`);
    for (const e of result.errors) println(`  ${e.path}: ${e.error}`);
  }
  for (const item of result.processed) {
    const note = item.needsAsr ? ' (queued for ASR)' : '';
    println(`  + ${item.path}${note}`);
  }
  if (result.errors.length) process.exitCode = 1;
}

async function cmdIntakeQuarantine(args, cwd) {
  const action = args[0];
  const { listQuarantine, readQuarantine } = await import('../lib/intake/quarantine.mjs');

  if (!action || action === 'list') {
    const packets = listQuarantine(cwd);
    if (packets.length === 0) {
      println('Quarantine is empty. Classifier had no low-confidence packets to hold.');
      return;
    }
    println(`Quarantine (${packets.length} packet${packets.length === 1 ? '' : 's'} awaiting review):`);
    const headers = ['ID', 'Type', 'Confidence', 'Reason'];
    const rows = packets.map((p) => {
      const t = p.triage || {};
      const conf = typeof t.confidence === 'number' ? t.confidence.toFixed(2) : '—';
      return [p.id, t.intakeType || 'unknown', conf, p.quarantineReason || 'n/a'];
    });
    const widths = headers.map((h, i) => Math.max(h.length, ...rows.map((r) => String(r[i] || '').length)));
    const fmt = (cells) => cells.map((c, i) => String(c || '').padEnd(widths[i])).join('  ');
    println(fmt(headers));
    println(widths.map((w) => '─'.repeat(w)).join('  '));
    for (const row of rows) println(fmt(row));
    println('');
    println('Review options:');
    println('  construct intake quarantine show <id>           See full triage + candidates');
    println('  construct intake reroute <id> --type=<correct>  Reclassify and promote to pending');
    println('  construct intake skip <id> --reason="..."        Drop without action');
    return;
  }

  if (action === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct intake quarantine show <id>'); process.exit(1); }
    const packet = readQuarantine(cwd, id);
    if (!packet) { errorln(`No quarantined packet with id: ${id}`); process.exit(1); }
    const t = packet.triage || {};
    println(`Quarantined packet ${packet.id}`);
    println(`Status:     quarantined`);
    println(`Reason:     ${packet.quarantineReason || 'n/a'}`);
    println(`Source:     ${packet.intake?.sourcePath || '(none)'}`);
    println(`Held since: ${packet.quarantinedAt || packet.createdAt}`);
    println('');
    println('Triage (current best guess):');
    println(`  intakeType:        ${t.intakeType || 'unknown'}`);
    println(`  primaryOwner:      ${t.primaryOwner || '—'}`);
    println(`  recommendedAction: ${t.recommendedAction || '—'}`);
    println(`  confidence:        ${typeof t.confidence === 'number' ? t.confidence.toFixed(2) : '—'}`);
    if (t.rationale) println(`  rationale:         ${t.rationale}`);
    if (Array.isArray(t.candidates) && t.candidates.length > 0) {
      println('');
      println('Candidates (top 3):');
      for (const c of t.candidates) {
        const score = typeof c.score === 'number' ? c.score.toFixed(2) : '—';
        const margin = typeof c.margin === 'number' ? c.margin.toFixed(2) : '—';
        println(`  ${c.intakeType.padEnd(20)} score=${score}  margin=${margin}  hits=${c.hits ?? 0}`);
      }
    }
    if (packet.excerpt) {
      println('');
      println('Excerpt:');
      for (const line of String(packet.excerpt).split('\n').slice(0, 10)) println(`  ${line}`);
    }
    println('');
    println('Next steps:');
    println(`  construct intake reroute ${packet.id} --type=<correct-type>     Reclassify + write learned fixture`);
    println(`  construct intake skip ${packet.id} --reason="..."                 Drop the packet`);
    return;
  }

  errorln(`Unknown quarantine subcommand: ${action}. Available: list, show`);
  process.exit(1);
}

async function cmdIntakeReroute(args, cwd) {
  const id = args[0];
  if (!id || id.startsWith('--')) {
    errorln('Usage: construct intake reroute <id> --type=<intakeType> [--reason="..."]');
    process.exit(1);
  }
  const flags = parseKvFlags(args.slice(1), ['type', 'reason']);
  if (!flags.type) {
    errorln('--type is required. See INTAKE_TYPES in lib/intake/tables/rnd.mjs for valid values.');
    process.exit(1);
  }
  const { INTAKE_TYPES } = await import('../lib/intake/classify.mjs');
  if (!INTAKE_TYPES.includes(flags.type)) {
    errorln(`Invalid --type=${flags.type}. Valid: ${INTAKE_TYPES.join(', ')}`);
    process.exit(1);
  }
  const { rerouteQuarantined } = await import('../lib/intake/quarantine.mjs');
  try {
    const result = rerouteQuarantined(cwd, id, flags.type, {
      reroutedBy: 'construct-intake-cli',
      reason: flags.reason || '',
    });
    info(`Rerouted ${result.id} to intakeType=${flags.type}. Learned fixture: ${result.fixturePath}`);
    info(`Packet promoted to pending: ${result.filePath}`);
  } catch (err) {
    errorln(err.message || 'reroute failed');
    process.exit(1);
  }
}

async function cmdIntakeExtractionWarnings(args) {
  const { createReadStream, existsSync } = await import('node:fs');
  const { homedir } = await import('node:os');
  const { join } = await import('node:path');
  const { createInterface } = await import('node:readline');

  const flags = parseKvFlags(args, ['since', 'kind', 'limit']);
  const limitN = flags.limit ? parseInt(flags.limit, 10) : 50;
  const filterKind = flags.kind || null;

  // Parse --since flag (e.g. 7d, 24h, 30m)
  let sinceMs = null;
  if (flags.since) {
    const m = flags.since.match(/^(\d+)([dhm])$/);
    if (m) {
      const n = parseInt(m[1], 10);
      sinceMs = Date.now() - n * ({ d: 86_400_000, h: 3_600_000, m: 60_000 }[m[2]] ?? 0);
    }
  }

  const logPath = join(homedir(), '.cx', 'intake', 'extraction-warnings.jsonl');
  if (!existsSync(logPath)) {
    println('No extraction warnings recorded yet.');
    return;
  }

  const lines = [];
  const rl = createInterface({ input: createReadStream(logPath), crlfDelay: Infinity });
  await new Promise((res) => {
    rl.on('line', (line) => {
      try {
        const entry = JSON.parse(line);
        if (sinceMs && new Date(entry.ts).getTime() < sinceMs) return;
        if (filterKind && !entry.droppedInfo?.some((d) => d.kind === filterKind)) return;
        lines.push(entry);
      } catch { /* ignore malformed lines */ }
    });
    rl.on('close', res);
  });

  if (lines.length === 0) {
    println('No extraction warnings match the given filters.');
    return;
  }

  const shown = lines.slice(-limitN);
  println(`Showing ${shown.length} of ${lines.length} extraction warning(s) (newest last):\n`);
  for (const entry of shown) {
    println(`  ${entry.ts}  ${entry.sourcePath}`);
    for (const d of entry.droppedInfo || []) {
      println(`    [${d.kind}] count=${d.count}  recoverable=${d.recoverable}  ${d.reason}`);
    }
  }

  // Summary by kind
  const kindCounts = {};
  for (const entry of lines) {
    for (const d of entry.droppedInfo || []) {
      kindCounts[d.kind] = (kindCounts[d.kind] ?? 0) + d.count;
    }
  }
  if (Object.keys(kindCounts).length > 0) {
    println('\nTotals by kind (all time):');
    for (const [kind, count] of Object.entries(kindCounts).sort(([, a], [, b]) => b - a)) {
      println(`  ${kind.padEnd(20)} ${count}`);
    }
  }
}

async function cmdIntakeNeedsAsr(args) {
  const { existsSync, readdirSync, readFileSync } = await import('node:fs');
  const { homedir } = await import('node:os');
  const { join } = await import('node:path');

  const sub = args[0] || 'list';
  const asrDir = join(homedir(), '.cx', 'intake', 'needs-asr');

  if (sub === 'list') {
    if (!existsSync(asrDir)) { println('No audio/video files awaiting ASR.'); return; }
    const files = readdirSync(asrDir).filter((f) => f.endsWith('.json'));
    if (files.length === 0) { println('No audio/video files awaiting ASR.'); return; }
    println(`${files.length} file(s) awaiting ASR:\n`);
    for (const f of files) {
      try {
        const p = JSON.parse(readFileSync(join(asrDir, f), 'utf8'));
        println(`  ${p.id}  ${p.extension}  ${p.sourcePath}`);
      } catch { println(`  ${f} (malformed packet)`); }
    }
    println('\nTo process: set CONSTRUCT_ASR_BACKEND=whisper|assemblyai and re-run construct embed start.');
    return;
  }

  if (sub === 'show') {
    const id = args[1];
    if (!id) { errorln('Usage: construct intake needs-asr show <id>'); process.exit(1); }
    if (!existsSync(asrDir)) { errorln('needs-asr queue is empty.'); process.exit(1); }
    const files = readdirSync(asrDir).filter((f) => f.startsWith(id) && f.endsWith('.json'));
    if (files.length === 0) { errorln(`No packet found for id: ${id}`); process.exit(1); }
    const p = JSON.parse(readFileSync(join(asrDir, files[0]), 'utf8'));
    println(JSON.stringify(p, null, 2));
    return;
  }

  errorln(`Unknown needs-asr subcommand: ${sub}. Available: list, show`);
  process.exit(1);
}

async function cmdSkillsUsage(sub, args) {
  const { summarizeSkillCalls, findOrphanSkills, hotSkills, DEFAULT_LOG_PATH } =
    await import('../lib/telemetry/skill-calls.mjs');
  const { existsSync, readdirSync, readFileSync } = await import('node:fs');
  const { join } = await import('node:path');

  const flags = {};
  for (let i = 0; i < args.length; i++) {
    const m = args[i].match(/^--(\w[\w-]*)(?:=(.+))?$/);
    if (m) flags[m[1]] = m[2] ?? args[++i] ?? true;
  }

  if (sub === 'usage') {
    const since = flags.since || '30d';
    const { skills, totalEvents } = summarizeSkillCalls({ since, agentId: flags.agent, source: flags.source });
    println(`Skill usage — last ${since}  (${totalEvents} events)\n`);
    const rows = Object.entries(skills).sort((a, b) => b[1].calls - a[1].calls);
    if (rows.length === 0) { println('No load events found.'); return; }
    for (const [id, s] of rows) {
      const latency = s.p50LatencyMs != null ? `  p50=${s.p50LatencyMs}ms p95=${s.p95LatencyMs}ms` : '';
      println(`  ${id.padEnd(50)} calls=${s.calls}  sessions=${s.sessions}  agents=${s.agents.length}${latency}`);
    }
    return;
  }

  if (sub === 'orphans') {
    const since = flags.since || '30d';
    const skillsRoot = join(ROOT_DIR, 'skills');
    if (!existsSync(skillsRoot)) { errorln('skills/ directory not found'); process.exit(1); }
    const allIds = [];
    function walk(dir, prefix = '') {
      for (const f of readdirSync(dir, { withFileTypes: true })) {
        const rel = prefix ? `${prefix}/${f.name}` : f.name;
        if (f.isDirectory()) {
          const skillMd = join(dir, f.name, 'SKILL.md');
          if (existsSync(skillMd)) allIds.push(rel);
          else walk(join(dir, f.name), rel);
        } else if (f.name.endsWith('.md') && f.name !== 'routing.md') {
          allIds.push(rel.replace(/\.md$/, ''));
        }
      }
    }
    walk(skillsRoot);
    const orphans = findOrphanSkills({ since, allSkillIds: allIds });
    if (orphans.length === 0) { println(`No orphan skills in the last ${since}.`); return; }
    println(`${orphans.length} skill(s) with no load events in the last ${since}:\n`);
    for (const id of orphans) println(`  ${id}`);
    return;
  }

  if (sub === 'hot') {
    const since = flags.since || '30d';
    const limit = parseInt(flags.limit || '20', 10);
    const rows = hotSkills({ since, limit });
    if (rows.length === 0) { println('No skill load events found.'); return; }
    println(`Top ${limit} skills — last ${since}\n`);
    for (const s of rows) {
      const latency = s.p50LatencyMs != null ? `  p50=${s.p50LatencyMs}ms` : '';
      println(`  ${s.skillId.padEnd(50)} calls=${s.calls}${latency}`);
    }
    return;
  }

  if (sub === 'correlate-quality') {
    // Queries the construct_skill_quality_correlation view (db/schema/010_cx_scores.sql)
    // which aggregates cx_score values by session_id × skill_id over the past 90 days.
    // Falls back to a clear "no data" message when the DB is unreachable or the
    // view is empty rather than printing an empty table.

    const sqlClient = createSqlClient(process.env);
    if (!sqlClient) {
      println('Quality correlation requires Postgres (DATABASE_URL or CONSTRUCT_DB_URL).');
      println('Local JSONL does not carry cx_score data.');
      println('Run with Postgres configured for full correlation output.');
      return;
    }
    try {
      const rows = await sqlClient`
        select skill_id, sessions, score_count, mean_score, median_score, p10_score, p90_score, last_scored_at
        from construct_skill_quality_correlation
        order by sessions desc, mean_score desc nulls last
        limit 50
      `;
      if (!rows || rows.length === 0) {
        println('No correlation data yet. The view aggregates cx_score values from the past 90 days against');
        println('skill invocations from the same sessions. Once cxScore() runs in a session that also invoked');
        println('a skill, rows appear here. Verify scoring with: construct telemetry query latency --limit=5');
        return;
      }
      const w = Math.max(15, ...rows.map((r) => String(r.skill_id || '').length));
      println(`${'skill_id'.padEnd(w)}  sessions  scores   mean   median   p10    p90    last_scored_at`);
      println('-'.repeat(w + 70));
      for (const r of rows) {
        const pad = (v, n) => String(v ?? '').padStart(n);
        println(
          `${String(r.skill_id || '').padEnd(w)}  ${pad(r.sessions, 8)}  ${pad(r.score_count, 6)}  ` +
          `${pad(r.mean_score, 5)}  ${pad(r.median_score, 6)}  ${pad(r.p10_score, 5)}  ${pad(r.p90_score, 5)}  ` +
          `${r.last_scored_at ? new Date(r.last_scored_at).toISOString().slice(0, 19) : ''}`,
        );
      }
    } catch (err) {
      errorln(`Quality correlation query failed: ${err.message}`);
      errorln('If the construct_skill_quality_correlation view is missing, apply db/schema/010_cx_scores.sql.');
      process.exit(1);
    } finally {
      await closeSqlClient(sqlClient);
    }
    return;
  }

  if (sub === 'backfill-postgres') {
    if (!process.env.CONSTRUCT_DB_URL) {
      errorln('CONSTRUCT_DB_URL not set — Postgres backfill requires a database connection.');
      process.exit(1);
    }
    println('Backfilling skill invocations from JSONL into Postgres…');
    if (!existsSync(DEFAULT_LOG_PATH)) { println('No JSONL log found at ' + DEFAULT_LOG_PATH); return; }
    const lines = readFileSync(DEFAULT_LOG_PATH, 'utf8').split('\n').filter(Boolean);
    println(`Found ${lines.length} JSONL entries. Connect and insert via your Postgres client.`);
    println('(Full Postgres backfill client available in team/enterprise deployment mode.)');
    return;
  }

  errorln(`Unknown skills subcommand: ${sub}. Available: usage, orphans, hot, correlate-quality, backfill-postgres`);
  process.exit(1);
}

async function cmdIntakeConfig(args) {
  const { loadIntakeConfig, saveIntakeConfig, INTAKE_DEPTH_GUIDANCE, INTAKE_HARD_MAX_DEPTH, describeIntakeDepth } =
    await import('../lib/intake/intake-config.mjs');
  const cwd = process.cwd();

  const action = args[0];
  if (!action || action === 'show') {
    const cfg = loadIntakeConfig(cwd, process.env);
    const desc = describeIntakeDepth(cfg.maxDepth);
    println(`Intake config (root: ${cwd})`);
    println('');
    println(`  includeProjectInbox: ${cfg.includeProjectInbox ? 'on' : 'off'} (.cx/inbox)`);
    println(`  includeDocsIntake:   ${cfg.includeDocsIntake ? 'on' : 'off'} (docs/intake)`);
    println(`  maxDepth:            ${cfg.maxDepth} — ${desc.label}`);
    println(`                       ${desc.detail}`);
    println(`  hardMaxDepth:        ${INTAKE_HARD_MAX_DEPTH}`);
    if (cfg.parentDirs.length === 0) {
      println('  parentDirs:          (none — only the built-in zones are watched)');
    } else {
      println('  parentDirs:');
      for (const dir of cfg.parentDirs) println(`    - ${dir}`);
    }
    println('');
    println('Depth guide:');
    for (const g of INTAKE_DEPTH_GUIDANCE) {
      println(`  ${String(g.value).padStart(2)}  ${g.label} — ${g.detail}`);
    }
    return;
  }

  if (action !== 'set') {
    errorln(`Unknown intake config action: ${action}. Available: show, set`);
    process.exit(1);
  }

  const patch = {};
  const tail = args.slice(1);
  const depthFlag = tail.find((a) => a.startsWith('--depth='));
  if (depthFlag) patch.maxDepth = Number(depthFlag.split('=')[1]);

  const projectFlag = tail.find((a) => a.startsWith('--include-project-inbox='));
  if (projectFlag) patch.includeProjectInbox = /^(on|true|1|yes)$/i.test(projectFlag.split('=')[1] || '');

  const docsFlag = tail.find((a) => a.startsWith('--include-docs-intake='));
  if (docsFlag) patch.includeDocsIntake = /^(on|true|1|yes)$/i.test(docsFlag.split('=')[1] || '');

  const addFlags = tail.filter((a) => a.startsWith('--add-dir='));
  const removeFlags = tail.filter((a) => a.startsWith('--remove-dir='));

  if (addFlags.length || removeFlags.length) {
    const current = loadIntakeConfig(cwd, process.env);
    const toAdd = addFlags.map((a) => a.split('=').slice(1).join('=')).filter(Boolean);
    const toRemove = new Set(removeFlags.map((a) => a.split('=').slice(1).join('=')).filter(Boolean));
    const next = [...current.parentDirs.filter((d) => !toRemove.has(d)), ...toAdd];
    patch.parentDirs = Array.from(new Set(next));
  }

  if (Object.keys(patch).length === 0) {
    errorln('Nothing to change. Pass --depth=N, --add-dir=PATH, --remove-dir=PATH, --include-project-inbox=on|off, or --include-docs-intake=on|off.');
    process.exit(1);
  }

  try {
    const saved = saveIntakeConfig(cwd, patch);
    println('Saved intake config:');
    println(JSON.stringify(saved, null, 2));
  } catch (err) {
    errorln(err.message || 'failed to save intake config');
    process.exit(1);
  }
}

async function cmdIntakeMetrics() {
  try {
    const { computeIntakeMetrics, pendingAge } = await import('../lib/embed/intake-metrics.mjs');
    const metrics = computeIntakeMetrics({ rootDir: process.cwd() });
    const age = pendingAge({ rootDir: process.cwd() });

    println(`${COLORS.bold}Intake pipeline metrics:${COLORS.reset}`);
    println('');
    println(`  ${COLORS.cyan}Volume${COLORS.reset}`);
    println(`    Pending:     ${metrics.volume.pending}`);
    println(`    Processed:   ${metrics.volume.processed}`);
    println(`    Skipped:     ${metrics.volume.skipped}`);
    println(`    Total:       ${metrics.volume.total}`);
    println('');
    println(`  ${COLORS.cyan}Velocity${COLORS.reset}`);
    println(`    Rate:        ${metrics.velocity} items/day (trailing 7d)`);
    if (metrics.avgProcessingTimeFormatted) {
      println(`    Avg process: ${metrics.avgProcessingTimeFormatted}`);
    }
    if (metrics.acceptRate !== null) {
      println(`    Accept rate: ${metrics.acceptRate}%`);
    }
    println('');
    println(`  ${COLORS.cyan}Customer intelligence${COLORS.reset}`);
    println(`    Customer-linked items: ${metrics.customerLinked}`);
    println('');
    println(`  ${COLORS.cyan}Recommendations${COLORS.reset}`);
    println(`    Active:      ${metrics.recommendations.active}`);
    println(`    Dismissed:   ${metrics.recommendations.dismissed}`);
    println(`    Total:       ${metrics.recommendations.total}`);
    println('');
    println(`  ${COLORS.cyan}Backlog${COLORS.reset}`);
    println(`    Pending items: ${age.count}`);
    if (age.oldest) {
      println(`    Oldest:      ${age.oldest} (${age.ageHours}h old)`);
      println(`    Stale (>24h): ${age.oldItemsCount}`);
    }
  } catch (err) {
    errorln(`Intake metrics error: ${err.message}`);
  }
}

async function cmdIntakeIntegrate(id, args, cwd) {
  if (!id) { errorln('Usage: construct intake integrate <id> <github|jira|confluence> [--publish-issues]'); process.exit(1); }

  const system = args[0];
  if (!system || !['github', 'jira', 'confluence'].includes(system)) {
    errorln('Usage: construct intake integrate <id> <github|jira|confluence> [--publish-issues]');
    errorln('Available systems: github, jira, confluence');
    process.exit(1);
  }
  // --publish-issues unlocks the demo-source gate (CONSTRUCT_DEMO env or
  // packet sourcePath under tests/fixtures/ or .cx/intake/demo/). Required
  // before any demo/fixture intake can publish a real external ticket.
  const publishDemo = args.includes('--publish-issues');

  const { createIntakeQueue } = await import('../lib/intake/queue.mjs');
  const queue = createIntakeQueue(cwd, process.env);
  const entry = queue.read(id);
  if (!entry) { errorln(`No intake packet with id: ${id}`); process.exit(1); }

  let result;

  if (system === 'github') {
    const { createGitHubIssue, tagIntakeWithExternalRef } = await import('../lib/integrations/intake-integrations.mjs');
    info(`Creating GitHub issue from intake ${id}...`);
    result = await createGitHubIssue(entry, { publishDemo });
    if (result.ok) {
      ok(`GitHub issue created: ${result.externalUrl}`);
      tagIntakeWithExternalRef(cwd, id, 'github', result.externalUrl, result.externalId);
    } else if (result.skipped === 'demo-source') {
      warn(`Skipped: ${result.error}`);
      process.exit(0);
    } else {
      errorln(`Failed: ${result.error}`);
      process.exit(1);
    }
  }

  if (system === 'jira') {
    const { createJiraTicket, tagIntakeWithExternalRef } = await import('../lib/integrations/intake-integrations.mjs');
    info(`Creating Jira ticket from intake ${id}...`);
    result = await createJiraTicket(entry);
    if (result.ok) {
      ok(`Jira ticket created: ${result.externalUrl}`);
      tagIntakeWithExternalRef(cwd, id, 'jira', result.externalUrl, result.externalId);
    } else {
      errorln(`Failed: ${result.error}`);
      process.exit(1);
    }
  }

  if (system === 'confluence') {
    const { publishArtifactToConfluence, tagIntakeWithExternalRef } = await import('../lib/integrations/intake-integrations.mjs');
    const artifact = {
      type: entry?.triage?.intakeType === 'requirement' ? 'prd' : 'adr',
      number: 1,
      title: entry?.excerpt?.slice(0, 60) || `Intake ${id}`,
      content: `# Intake: ${id}\n\n${entry?.excerpt || ''}\n\nSee also: ${entry?.intake?.sourcePath || ''}`,
    };
    info(`Publishing Confluence page from intake ${id}...`);
    result = await publishArtifactToConfluence(artifact);
    if (result.ok) {
      ok(`Confluence page: ${result.externalUrl}`);
      tagIntakeWithExternalRef(cwd, id, 'confluence', result.externalUrl, result.externalId);
    } else {
      errorln(`Failed: ${result.error}`);
      process.exit(1);
    }
  }
}

