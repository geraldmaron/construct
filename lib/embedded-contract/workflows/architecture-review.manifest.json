{
  "id": "architecture-review",
  "version": "1.0.0",
  "type": "linear",
  "modes": ["solo", "team"],
  "surfaces": ["mcp", "cli"],
  "roleChain": ["architect", "security", "reviewer"],
  "defaultApprovalMode": "requires-human-approval",
  "outputSchema": { "artifact": "review-report" },
  "durableStateModel": "none",
  "tier": "reasoning",
  "description": "Review an architecture or design for trade-offs, failure modes, and security exposure.",
  "owner": "construct-core",
  "compatVersion": 1
}