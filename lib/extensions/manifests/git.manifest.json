{
  "id": "git",
  "version": "1.0.0",
  "kind": "data-source",
  "capabilities": [
    "read"
  ],
  "secretEnvKeys": [],
  "operations": [
    "read"
  ],
  "securityClassification": "trusted",
  "owner": "construct-core",
  "compatVersion": 1,
  "installSource": "builtin",
  "sourceTarget": {
    "provider": "git",
    "selector": {
      "field": "remote",
      "hint": "required git remote (ssh/https URL, file:// URL, or local path)",
      "normalize": "trim",
      "expand": "tilde"
    },
    "signature": {
      "template": "git:remote:{value}",
      "valueMode": "path"
    },
    "content": {
      "field": "content",
      "modeField": "mode",
      "modeValue": "corpus",
      "refField": "ref",
      "defaultRef": "main",
      "remoteField": "remote",
      "clone": "git"
    },
    "aliases": {
      "strategy": "path",
      "displayPrefix": null,
      "catchAll": false
    }
  },
  "certification": {
    "tier": "process-boundary-tested",
    "computedAt": "2026-07-21",
    "computedBy": "lib/certification/provider-evidence-tiers.mjs#auditKnownProviderManifests",
    "reason": "a functional test crosses a real subprocess boundary, but live-sandbox verification requires an explicit human attestation not present in the manifest",
    "evidence": {
      "contractTestFiles": [],
      "processBoundaryTestFiles": [
        "tests/functional/source-links.functional.test.mjs",
        "tests/functional/source-target-git.functional.test.mjs"
      ]
    },
    "manualAttestation": {
      "liveSandboxTested": {
        "attested": false,
        "attestedAt": null,
        "attestedBy": null,
        "note": null
      },
      "productionProven": {
        "attested": false,
        "attestedAt": null,
        "attestedBy": null,
        "note": null
      }
    }
  }
}
