{
  "id": "github",
  "version": "1.0.0",
  "kind": "data-source",
  "capabilities": ["read", "search", "webhook"],
  "secretEnvKeys": ["GITHUB_TOKEN", "GH_TOKEN"],
  "operations": ["read", "search", "webhook"],
  "securityClassification": "trusted",
  "owner": "construct-core",
  "compatVersion": 1,
  "installSource": "builtin",
  "sourceTarget": {
    "provider": "github",
    "selector": {
      "field": "repo",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "patternTransform": "trim",
      "hint": "required owner/repo slug",
      "normalize": "trim"
    },
    "signature": { "template": "github:repo:{value}", "valueMode": "optionalLower" },
    "content": {
      "field": "content",
      "modeField": "mode",
      "modeValue": "corpus",
      "refField": "ref",
      "defaultRef": "main",
      "remoteField": "remote",
      "remoteTemplate": "https://github.com/{value}.git",
      "clone": "git"
    },
    "legacyEnv": { "vars": ["GITHUB_REPOS", "GITHUB_REPO"], "parse": "csv" },
    "aliases": { "strategy": "repoWords", "displayPrefix": null, "catchAll": false },
    "embed": {
      "mode": "aggregate",
      "valueField": "repos",
      "valueKind": "array",
      "groups": [
        { "refs": ["prs", "issues", "commits"], "limit": 25 },
        { "refs": ["meta", "readme", "docs"], "limit": 25 }
      ]
    },
    "embedFilters": {
      "valueField": "repos",
      "valueKind": "array",
      "defaultRefs": ["prs", "issues", "commits"],
      "refsFilterKey": "refs",
      "defaultLimit": 25
    },
    "demandFetch": {
      "targetRefs": ["meta", "readme", "docs", "prs", "issues", "commits"],
      "targetRefsFilterKey": "refs",
      "targetOptsField": "repos",
      "targetOptsKind": "array",
      "targetDefaultLimit": 25,
      "queryRefs": ["meta", "readme", "docs", "prs", "issues", "commits"],
      "queryOptsField": "repos",
      "queryOptsKind": "array",
      "queryDefaultLimit": 25
    }
  },
  "certification": {
    "tier": "process-boundary-tested",
    "computedAt": "2026-07-16",
    "computedBy": "lib/certification/provider-evidence-tiers.mjs#auditKnownProviderManifests (construct-4uxq0.13.2)",
    "reason": "a functional test crosses a real subprocess boundary, but live-sandbox verification requires an explicit human attestation not present in the manifest",
    "evidence": {
      "contractTestFiles": ["tests/embed/providers.test.mjs", "tests/provider-github.test.mjs", "tests/providers/scope-validators.test.mjs", "tests/writes/github.functional.test.mjs"],
      "processBoundaryTestFiles": ["tests/functional/doctor-source-targets.functional.test.mjs", "tests/functional/source-target-directory.functional.test.mjs"]
    },
    "manualAttestation": {
      "liveSandboxTested": { "attested": false, "attestedAt": null, "attestedBy": null, "note": null },
      "productionProven": { "attested": false, "attestedAt": null, "attestedBy": null, "note": null }
    }
  }
}
