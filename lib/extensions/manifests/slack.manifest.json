{
  "id": "slack",
  "version": "1.0.0",
  "kind": "data-source",
  "capabilities": ["read", "search"],
  "secretEnvKeys": ["SLACK_BOT_TOKEN", "SLACK_USER_TOKEN"],
  "operations": ["read", "search"],
  "securityClassification": "trusted",
  "owner": "construct-core",
  "compatVersion": 1,
  "installSource": "builtin",
  "sourceTarget": {
    "provider": "slack",
    "selector": {
      "field": "channel",
      "pattern": null,
      "patternTransform": "trim",
      "hint": "required Slack channel name or ID",
      "normalize": "trimHash"
    },
    "secondaryField": {
      "field": "intent",
      "enum": ["internal", "risk", "decision", "external", "how-to"],
      "hint": "must be one of",
      "default": "internal"
    },
    "signature": { "template": "slack:channel:{value}:intent:{intent}", "valueMode": "lowerOrEmpty" },
    "legacyEnv": { "vars": ["SLACK_CHANNELS", "SLACK_CHANNEL"], "parse": "slackChannelColon" },
    "aliases": { "strategy": "simple", "displayPrefix": "Slack", "catchAll": false },
    "embed": {
      "mode": "groupBy",
      "groupField": "intent",
      "groupDefault": "internal",
      "valueField": "channels",
      "valueKind": "array",
      "refs": ["messages"],
      "oldest": 86400,
      "limit": 50
    },
    "embedFilters": {
      "valueField": "channels",
      "valueKind": "array",
      "defaultRefs": ["messages"],
      "extraFilterKeys": ["oldest"],
      "defaultLimit": 50,
      "includeSecondaryField": true
    },
    "demandFetch": {
      "targetRefs": ["messages"],
      "targetOptsField": "channels",
      "targetOptsKind": "array",
      "targetExtraFilterKeys": ["oldest"],
      "targetOldestDefault": 86400,
      "targetDefaultLimit": 50,
      "querySupported": false
    }
  },
  "certification": {
    "tier": "contract-tested",
    "computedAt": "2026-07-16",
    "computedBy": "lib/certification/provider-evidence-tiers.mjs#auditKnownProviderManifests (construct-4uxq0.13.2)",
    "reason": "adapter code is exercised against a fake wire boundary, but no test crosses a real subprocess/HTTP boundary",
    "evidence": {
      "contractTestFiles": ["tests/embed-slack-intent.test.mjs", "tests/embed/providers.test.mjs"]
    },
    "manualAttestation": {
      "liveSandboxTested": { "attested": false, "attestedAt": null, "attestedBy": null, "note": null },
      "productionProven": { "attested": false, "attestedAt": null, "attestedBy": null, "note": null }
    }
  }
}
