{
  "name": "@geraldmaron/construct",
  "version": "2.0.1",
  "type": "module",
  "packageManager": "npm@11.5.1",
  "description": "Construct — agent orchestration layer for OpenCode, Claude Code, and other coding surfaces",
  "bin": {
    "construct": "bin/construct"
  },
  "exports": {
    ".": "./lib/embedded-contract/index.mjs",
    "./embedded-contract": "./lib/embedded-contract/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/construct",
    "bin/construct-postinstall.mjs",
    "lib/**",
    "packages/construct-ui/**",
    "examples/**",
    "commands/**",
    "skills/**",
    "rules/**",
    "platforms/**",
    "templates/**",
    "schemas/**",
    "registry/**",
    "config/**",
    "vendor/**",
    "scripts/sync-worker-profiles.mjs",
    "scripts/check-procedure-definitions-drift.mjs",
    "scripts/lint-commits-pr.mjs",
    "scripts/optimize.mjs",
    "scripts/review.mjs",
    "scripts/seed-traces.mjs",
    "scripts/tag-candidate-mining.mjs",
    "scripts/refresh-ci-status.mjs",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geraldmaron/construct.git"
  },
  "homepage": "https://github.com/geraldmaron/construct",
  "bugs": {
    "url": "https://github.com/geraldmaron/construct/issues"
  },
  "scripts": {
    "mcp": "node lib/mcp/server.mjs",
    "doctor": "node ./bin/construct doctor",
    "test": "node scripts/run-tests.mjs",
    "test:functional": "XDG_CONFIG_HOME= XDG_STATE_HOME= XDG_CACHE_HOME= ANTHROPIC_API_KEY= OPENAI_API_KEY= OPENROUTER_API_KEY= CONSTRUCT_MODEL_REASONING= CONSTRUCT_MODEL_STANDARD= CONSTRUCT_MODEL_FAST= CONSTRUCT_MODEL_REASONING= CONSTRUCT_MODEL_STANDARD= CONSTRUCT_MODEL_FAST= CONSTRUCT_PROVIDER_TIMEOUT_MS= WEB_SEARCH_URL= CONSTRUCT_USER_ENV_PATH= CONSTRUCT_TELEMETRY_URL= node --test --test-timeout=120000 --test-concurrency=1 tests/functional/*.functional.test.mjs",
    "test:visual": "node --test --test-timeout=120000 tests/visual/*.test.mjs",
    "test:unit": "node scripts/run-tests.mjs --exclude=tests/functional",
    "ci:local": "bash scripts/ci-repro/run.sh",
    "lint:js": "eslint bin/construct \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "coverage": "c8 --reporter=text-summary --reporter=lcov --src=lib --src=bin node scripts/run-tests.mjs --exclude=tests/functional",
    "docs:init": "node -e \"console.error('docs:init is deprecated — use: construct init --docs-preset=lean|product|full'); process.exit(1)\"",
    "docs:verify": "node ./bin/construct docs:verify",
    "docs:update": "node ./bin/construct docs:update",
    "docs:site": "node ./bin/construct docs:site",
    "docs:dev": "node scripts/npm-run.mjs npm --prefix apps/docs run dev",
    "docs:build": "node scripts/npm-run.mjs npm --prefix apps/docs run build",
    "lint:comments": "node ./bin/construct lint:comments",
    "lint:contracts": "node ./bin/construct lint:contracts",
    "graph:gate": "node scripts/run-graph-gate.mjs",
    "graph:verify": "node scripts/run-graph-verify.mjs",
    "graph:impact-promotion": "node scripts/graph-impact-promotion-report.mjs",
    "graph:impact-gate": "node scripts/graph-impact-gate.mjs",
    "lint:agents": "node ./bin/construct lint:worker-profiles",
    "gates:audit": "node ./bin/construct gates:audit",
    "evals": "node ./bin/construct evals",
    "certify:demos": "node ./bin/construct certify demos",
    "certify:document-io": "node ./bin/construct certify document-io --certified",
    "build:sea": "esbuild bin/construct --bundle --platform=node --target=node20 --packages=external --outfile=dist/construct-bundle.cjs 2>&1 || (echo 'esbuild not found — install with: npm install -g esbuild' && exit 1)",
    "build:binary": "node scripts/build-binary.mjs",
    "build:binary:fallback": "node scripts/build-sea.mjs",
    "examples:deck": "node scripts/generate-deck-examples.mjs",
    "examples:distribution": "node scripts/generate-distribution-examples.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "lint:workspace-presets": "node scripts/lint-workspace-presets.mjs",
    "catalog:regen": "node scripts/catalog-regen.mjs",
    "catalog:validate": "node scripts/catalog-validate.mjs",
    "skills:routes": "node scripts/generate-skill-routing.mjs",
    "worker-profiles:coverage": "node scripts/generate-worker-profile-coverage.mjs",
    "procedure-definitions:check": "node scripts/check-procedure-definitions-drift.mjs --check",
    "docs:sync": "node scripts/docs-sync.mjs",
    "learning:status": "node scripts/learning-status.mjs",
    "lint:templates": "node scripts/lint-commits-pr.mjs",
    "eval:routing": "node scripts/eval/score-intent-classifier.mjs",
    "eval:skill-routing": "node scripts/eval/skill-routing-bench.mjs",
    "adapters": "node lib/adapters-sync.mjs",
    "release:check": "npm run doctor && node ./bin/construct registry:validate --unified && npm run catalog:validate -- --check && npm run skills:routes -- --check && npm run worker-profiles:coverage -- --check && npm run procedure-definitions:check && npm test && node scripts/release-evidence-gate.mjs --skip-tests && node lib/certification/protocol-surface-rollup.mjs && npm run docs:update -- --check && npm run docs:site -- --check && npm run docs:sync -- --check && node ./bin/construct registry:generate-docs --check && npm run docs:verify -- --strict && node scripts/alignment/census.mjs --ratchet && npm run lint:comments && node ./bin/construct certify gate && npm run graph:gate && npm run graph:verify && npm run lint:templates",
    "release:gate": "node --test tests/functional/release-gate.functional.test.mjs",
    "audit:published": "node scripts/audit-published-artifact.mjs",
    "version": "node scripts/sync-construct-version.mjs && git add -f .construct/launcher/version",
    "release:preflight": "node scripts/pre-release-check.mjs",
    "release:preflight:no-auth": "node scripts/pre-release-check.mjs --skip-auth",
    "npm:publish": "npm run release:check && npm publish --access public",
    "postinstall": "node ./bin/construct-postinstall.mjs",
    "deps:check": "node scripts/validate-dep-intent.mjs",
    "supply-chain:exceptions": "node scripts/check-supply-chain-exceptions.mjs",
    "supply-chain:gate": "node scripts/supply-chain-release-gate.mjs",
    "compat:check": "node scripts/validate-compat-surfaces.mjs",
    "static:knip": "knip --reporter compact",
    "static:cruise": "depcruise --config .dependency-cruiser.cjs --output-type err bin lib scripts tests packages --validate",
    "lint:scopes": "node scripts/lint-workspace-presets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^5.2.1",
    "mailparser": "^3.9.14",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^4.0.9",
    "@ai-sdk/openai": "^4.0.8",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@lancedb/lancedb": "0.30.0",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7.0.17",
    "apache-arrow": "^18.1.0",
    "ink": "^7.1.0",
    "mammoth": "^1.12.0",
    "postgres": "^3.4.9",
    "pptx-embed-fonts": "^0.0.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "@eslint/js": "^9.39.4",
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "c8": "^11.0.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.27.0",
    "playwright": "^1.61.1",
    "postject": "1.0.0-alpha.6"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "overrides": {
    "adm-zip": "0.6.0",
    "lodash-es": "4.18.1",
    "postcss": "8.5.10",
    "nanoid@3": "3.3.8",
    "nanoid@4": "5.0.9"
  }
}
