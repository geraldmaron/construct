{
  "name": "@geraldmaron/construct",
  "version": "3.0.0-alpha.7",
  "description": "Outcome engine: state an outcome, a learning staff of roles fills in the rest \u2014 decisions in, deliverables out.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geraldmaron/construct.git"
  },
  "homepage": "https://github.com/geraldmaron/construct#readme",
  "bugs": {
    "url": "https://github.com/geraldmaron/construct/issues"
  },
  "keywords": [
    "outcome",
    "agent",
    "orchestration",
    "mcp",
    "opencode",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "construct": "bin/construct.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schemas"
  ],
  "exports": {
    ".": "./dist/kernel/index.js",
    "./kernel/*": "./dist/kernel/*",
    "./hosts/*": "./dist/hosts/*"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-no-absolute-paths.mjs && node scripts/lint-glossary-parity.mjs && node scripts/lint-no-bead-refs.mjs && node scripts/generate-org-map.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke": "bash scripts/smoke-packaged-install.sh",
    "reconcile": "node scripts/reconcile-tracker.mjs",
    "probe:opencode": "node scripts/probe-opencode-conformance.mjs",
    "capture:opencode": "node scripts/capture-opencode-transcripts.mjs",
    "harness:discrimination": "node scripts/check-plant-discrimination.mjs",
    "probe:claude": "node scripts/probe-claude-conformance.mjs",
    "probe:codex": "node scripts/probe-codex-conformance.mjs",
    "probe:cursor": "node scripts/probe-cursor-conformance.mjs",
    "probe:claude:mcp": "node scripts/probe-claude-conformance.mjs --spend-mcp",
    "check:research": "node scripts/check-research-discipline.mjs",
    "docs:org-map": "node scripts/generate-org-map.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
