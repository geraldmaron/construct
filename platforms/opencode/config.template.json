{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "anthropic",
    "openai",
    "openrouter",
    "ollama"
  ],
  "provider": {
    "anthropic": {
      "models": {}
    },
    "openai": {
      "models": {}
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "HTTP-Referer": "https://github.com/geraldmaron/construct",
          "X-Title": "Construct",
          "Authorization": "Bearer __OPENROUTER_API_KEY__"
        }
      },
      "models": {}
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "headers": {
          "Authorization": "Bearer ollama"
        }
      },
      "models": {}
    }
  },
  "mcp": {
    "construct-mcp": {
      "type": "local",
      "command": ["node", "__CONSTRUCT_TOOLKIT_DIR__/lib/mcp/server.mjs"],
      "environment": {
        "CONSTRUCT_TRACE_BACKEND": "__CONSTRUCT_TRACE_BACKEND__",
        "CONSTRUCT_TELEMETRY_URL": "__CONSTRUCT_TELEMETRY_URL__",
        "CONSTRUCT_TELEMETRY_PUBLIC_KEY": "__CONSTRUCT_TELEMETRY_PUBLIC_KEY__",
        "CONSTRUCT_TELEMETRY_SECRET_KEY": "__CONSTRUCT_TELEMETRY_SECRET_KEY__"
      }
    }
  },
  "agent": {
    "__AGENTS_GENERATED_BY_CONSTRUCT_SYNC__": {}
  }
}
