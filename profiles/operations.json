{
  "$schema": "../schemas/profile.schema.json",
  "id": "operations",
  "displayName": "Operations",
  "tagline": "Request, triage, resolve, document, improve. Keep things running.",
  "extends": null,
  "roles": [
    "operator",
    "engineer",
    "qa",
    "sre",
    "security",
    "docs-keeper",
    "reviewer",
    "product-lead"
  ],
  "teams": [
    {
      "id": "triage-team",
      "name": "Triage Team",
      "owner": "product-lead",
      "roles": ["operator", "product-lead"],
      "decisionRights": ["intake-triage", "priority-setting", "routing"],
      "forbiddenDecisions": ["implementation", "deployment"],
      "escalationPath": ["product-lead"],
      "charter": "Triage incoming requests and route them to the right team. Owns queue management, initial response, and prioritization. Does not own implementation or deployment decisions.",
      "contact": {
        "slack": "#intake",
        "email": "triage@example.com",
        "owner": "product-lead"
      }
    },
    {
      "id": "delivery-team",
      "name": "Delivery Team",
      "owner": "engineer",
      "roles": ["engineer", "qa", "reviewer"],
      "decisionRights": ["implementation", "testing", "review-approval"],
      "forbiddenDecisions": ["deployment", "scope-change"],
      "escalationPath": ["engineer"],
      "charter": "Resolve requests and deliver fixes. Owns implementation, testing, and code review. Does not own deployment timing or scope changes.",
      "contact": {
        "slack": "#delivery",
        "email": "delivery@example.com",
        "owner": "engineer"
      }
    },
    {
      "id": "reliability-team",
      "name": "Reliability Team",
      "owner": "sre",
      "roles": ["sre", "security", "docs-keeper"],
      "decisionRights": ["deployment", "incident-response", "runbook-approval", "rollback"],
      "forbiddenDecisions": ["implementation", "scope-change"],
      "escalationPath": ["sre"],
      "charter": "Keep the system up and the audit trail honest. Owns incident response, deployments, runbooks, and documentation. Does not own implementation decisions.",
      "contact": {
        "slack": "#reliability",
        "email": "reliability@example.com",
        "owner": "sre"
      }
    }
  ],
  "departments": [
    {
      "id": "intake",
      "displayName": "Intake",
      "charter": "Triage requests and route them. Owns the queue and the first response. Does not own implementation.",
      "roles": ["operator", "product-lead"]
    },
    {
      "id": "delivery",
      "displayName": "Delivery",
      "charter": "Resolve requests. Owns fixes, small builds, and the verification step that closes the loop.",
      "roles": ["engineer", "qa", "reviewer"]
    },
    {
      "id": "reliability",
      "displayName": "Reliability",
      "charter": "Keep the system up and the audit trail honest. Owns incident response, runbook authorship, and security review.",
      "roles": ["sre", "security", "docs-keeper"]
    }
  ],
  "intake": {
    "types": [
      "request",
      "bug",
      "incident",
      "ops",
      "security",
      "docs",
      "unknown"
    ],
    "stages": [
      "request",
      "triage",
      "resolve",
      "document",
      "improve"
    ],
    "classificationTable": "lib/intake/tables/operations.mjs"
  },
  "docTemplates": [
    "runbook",
    "incident-report",
    "memo",
    "one-pager",
    "changelog-entry"
  ],
  "hooks": {
    "sessionReflect": "on",
    "sessionOptimize": "on"
  },
  "defaultSkills": [],
  "toneDefaults": {
    "runbook": "blameless",
    "incident-report": "blameless",
    "memo": "direct"
  },
  "researchProfiles": {
    "incident": "codebase",
    "request": "external",
    "change": "codebase"
  },
  "rebrand": {
    "intakeQueueLabel": "Request queue",
    "signalNoun": "request"
  }
}
