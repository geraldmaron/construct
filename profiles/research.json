{
  "$schema": "../schemas/profile.schema.json",
  "id": "research",
  "displayName": "Research",
  "tagline": "Question, gather, analyze, synthesize, recommend. Investigate and report.",
  "extends": null,
  "roles": [
    "researcher",
    "ux-researcher",
    "data-analyst",
    "evaluator",
    "reviewer",
    "product-lead",
    "operator"
  ],
  "teams": [
    {
      "id": "discovery-team",
      "name": "Discovery Team",
      "owner": "researcher",
      "roles": ["researcher", "ux-researcher"],
      "decisionRights": ["question-scoping", "methodology-selection", "protocol-design"],
      "forbiddenDecisions": ["analysis", "synthesis", "recommendation"],
      "escalationPath": ["researcher"],
      "charter": "Pose the right question and design rigorous methods to answer it. Owns research scoping, methodology choice, and protocol design. Does not own analysis or recommendations.",
      "contact": {
        "slack": "#discovery",
        "email": "discovery@example.com",
        "owner": "researcher"
      }
    },
    {
      "id": "analysis-team",
      "name": "Analysis Team",
      "owner": "data-analyst",
      "roles": ["data-analyst", "evaluator"],
      "decisionRights": ["analysis", "evaluation-design", "finding-validation"],
      "forbiddenDecisions": ["question-scoping", "recommendation"],
      "escalationPath": ["data-analyst"],
      "charter": "Turn evidence into findings. Owns data analysis, evaluation against hypotheses, and synthesis. Does not own research scoping or final recommendations.",
      "contact": {
        "slack": "#analysis",
        "email": "analysis@example.com",
        "owner": "data-analyst"
      }
    },
    {
      "id": "delivery-team",
      "name": "Delivery Team",
      "owner": "reviewer",
      "roles": ["reviewer", "product-lead", "operator"],
      "decisionRights": ["peer-review", "recommendation-framing", "dissemination"],
      "forbiddenDecisions": ["analysis", "question-scoping"],
      "escalationPath": ["reviewer"],
      "charter": "Get findings into the hands that need them. Owns peer review, recommendation framing, and stakeholder communication. Does not own analysis or research design.",
      "contact": {
        "slack": "#delivery",
        "email": "delivery@example.com",
        "owner": "reviewer"
      }
    }
  ],
  "departments": [
    {
      "id": "discovery",
      "displayName": "Discovery",
      "charter": "Pose the right question. Owns scoping, methodology choice, and protocol design.",
      "roles": ["researcher", "ux-researcher"]
    },
    {
      "id": "analysis",
      "displayName": "Analysis",
      "charter": "Turn evidence into findings. Owns data work, evaluation against hypotheses, and synthesis.",
      "roles": ["data-analyst", "evaluator"]
    },
    {
      "id": "delivery",
      "displayName": "Delivery",
      "charter": "Get findings into the hands that need them. Owns peer review, recommendation framing, and operator coordination.",
      "roles": ["reviewer", "product-lead", "operator"]
    }
  ],
  "intake": {
    "types": [
      "question",
      "study",
      "synthesis",
      "report",
      "experiment",
      "ops",
      "unknown"
    ],
    "stages": [
      "question",
      "gather",
      "analyze",
      "synthesize",
      "recommend"
    ],
    "classificationTable": "lib/intake/tables/research.mjs"
  },
  "docTemplates": [
    "research-brief",
    "evidence-brief",
    "one-pager",
    "memo",
    "strategy"
  ],
  "hooks": {
    "sessionReflect": "on",
    "sessionOptimize": "on"
  },
  "defaultSkills": [],
  "toneDefaults": {
    "research-brief": "direct",
    "evidence-brief": "direct",
    "memo": "executive-concise"
  },
  "researchProfiles": {
    "question": "external",
    "study": "user",
    "synthesis": "external",
    "report": "external",
    "experiment": "external"
  },
  "rebrand": {
    "intakeQueueLabel": "Research queue",
    "signalNoun": "question"
  },
  "capabilities": {
    "intake": {
      "inbox": true,
      "dedup": "sha256",
      "attribution": true
    }
  }
}
