{
  "$schema": "./artifact-manifest.schema.json",
  "version": 2,
  "description": "Single source of truth for registered document classes: template, author and reviewer chains, workflow skill, validation, output capability, tone, structure, visuals, and release gates.",
  "workflowDefaults": {
    "validation": {
      "releaseGate": true
    },
    "outputs": {
      "formats": ["pdf", "docx", "doc", "deck", "pptx", "html", "rtf", "odt", "epub", "tex", "txt", "md", "mdx"],
      "branding": "construct"
    },
    "qualityContract": {
      "gateLevel": "standard",
      "requiredStates": ["exported", "file-valid"]
    }
  },
  "artifacts": {
    "prd": {
      "vibeProfile": "construct-modern",
      "template": "templates/docs/prd.md",
      "primaryOwners": ["product-manager"],
      "workflowSkill": "docs/prd-workflow",
      "toneDefault": "decision-forcing-direct",
      "toneAllowed": ["decision-forcing-direct", "executive-concise"],
      "structureRequirements": ["Problem", "Goals", "Success metrics", "Phases", "Risks and mitigations"],
      "visualRequirements": [
        { "id": "prd-user-flow", "check": "artifact-has-mermaid", "diagram": "flowchart" },
        { "id": "prd-metrics-table", "check": "artifact-table-has-columns", "columns": ["Metric", "Baseline", "Target"] }
      ],
      "researchProfile": "user",
      "releaseGate": {
        "structuralLint": true,
        "citationLint": true,
        "proseMinimum": 3,
        "requiredReviewers": ["reviewer"],
        "optionalReviewers": ["researcher"]
      },
      "qualityContract": {
        "gateLevel": "render-smoke",
        "requiredStates": ["exported", "file-valid", "renderable"],
        "perFormat": {
          "pdf": { "requiredStates": ["file-valid", "renderable"], "a11y": "wcag-2.1-aa" }
        }
      }
    },
    "prd-platform": {
      "template": "templates/docs/prd-platform.md",
      "primaryOwners": ["product-manager"],
      "workflowSkill": "docs/prd-workflow",
