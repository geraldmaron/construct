{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construct.dev/schemas/continuation-packet.schema.json",
  "title": "ContinuationPacket",
  "description": "Structured, re-verifiable record of a compacted chat-session context (construct-6zga.1.9). Retains required state verbatim, references reconstructible layers by source id, elides compactible layers with a truthful marker, and carries a blocker when required state alone exceeds the continuation budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "budget", "layers", "requiredState", "blocker"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggerTokens", "requiredTokens", "retainedTokens", "elidedTokens", "referencedCount"],
      "properties": {
        "triggerTokens": { "type": ["integer", "null"], "minimum": 0 },
        "requiredTokens": { "type": "integer", "minimum": 0 },
        "retainedTokens": { "type": "integer", "minimum": 0 },
        "elidedTokens": { "type": "integer", "minimum": 0 },
        "referencedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    },
    "requiredState": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "tokens"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "$ref": "#/$defs/layerKind" },
          "sourceId": { "type": ["string", "null"] },
          "tokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "requiredTokens", "budgetTokens", "overflowTokens"],
          "properties": {
            "reason": { "type": "string" },
            "requiredTokens": { "type": "integer", "minimum": 0 },
            "budgetTokens": { "type": ["integer", "number"], "minimum": 0 },
            "overflowTokens": { "type": "integer" }
          }
        }
      ]
    }
  },
  "$defs": {
    "layerKind": {
      "enum": [
        "static-instructions",
        "role-guidance",
        "task-packet",
        "validated-evidence",
        "tool-results",
        "conversation-summary",
        "learned-patterns",
        "user-constraints",
        "approvals",
        "blockers"
      ]
    },
    "eligibility": { "enum": ["required", "reconstructible", "compactible"] },
    "disposition": { "enum": ["retained", "referenced", "elided"] },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "eligibility", "disposition", "tokens"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "$ref": "#/$defs/layerKind" },
        "eligibility": { "$ref": "#/$defs/eligibility" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "tokens": { "type": "integer", "minimum": 0 },
        "sourceId": { "type": ["string", "null"] },
        "content": { "type": ["string", "null"] }
      }
    }
  }
}
