{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geraldmaron.github.io/construct/schemas/profile.schema.json",
  "title": "Construct org profile",
  "description": "A curated or user-defined org type. Drives the role set, intake taxonomy, doc templates, hooks, and default skills that Construct applies in a project.",
  "type": "object",
  "required": ["id", "displayName", "roles", "intake"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "description": "Lowercase id used in config and CLI flags."
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tagline": { "type": "string", "maxLength": 120 },
    "extends": { "type": ["string", "null"] },
    "custom": { "type": "boolean", "default": false },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "description": "Flat list of role ids referenced by this profile. Real org headcount can be larger; this cap exists so a runaway profile cannot tax the sync pipeline. Roles should typically be grouped under departments[].",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" }
    },
    "departments": {
      "type": "array",
      "maxItems": 12,
      "description": "Departmental grouping of roles, mirroring how the target org actually delegates. Each department has a charter (one-paragraph mission statement) and a roster of role ids. Derived from organizational-design research, not invented.",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "charter", "roles"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
          "charter": { "type": "string", "minLength": 20, "maxLength": 600, "description": "One-paragraph mission statement: what this department owns, what it does not own, who it hands off to." },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" }
          },
          "evidence": {
            "type": "array",
            "description": "Primary sources used to justify this department exists (interview transcripts, public job specs, ADRs). Required when promoting from draft.",
            "items": { "type": "string" }
          }
        }
      }
    },
    "intake": {
      "type": "object",
      "required": ["types", "stages"],
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
        },
        "classificationTable": {
          "type": ["string", "null"],
          "description": "Module path resolved relative to repo root. Optional. B2 ships per-profile tables for the curated set."
        }
      }
    },
    "docTemplates": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionReflect": { "type": "string", "enum": ["on", "off"] },
        "sessionOptimize": { "type": "string", "enum": ["on", "off"] }
      }
    },
    "defaultSkills": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string" }
    },
    "rebrand": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "intakeQueueLabel": { "type": "string", "maxLength": 60 },
        "signalNoun": { "type": "string", "maxLength": 30 }
      }
    },
    "departments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
