{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construct.dev/schemas/unified-registry.schema.json",
  "title": "Construct Registry",
  "description": "Canonical public registry of workspace presets, worker profiles, procedures, capabilities, and policies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspacePresets", "workerProfiles", "procedures", "capabilities", "policies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspacePresets": { "$ref": "#/$defs/workspacePresetMap" },
    "workerProfiles": { "$ref": "#/$defs/workerProfileMap" },
    "procedures": { "$ref": "#/$defs/procedureMap" },
    "capabilities": { "$ref": "#/$defs/capabilityMap" },
    "policies": { "$ref": "#/$defs/policyMap" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,80}$" },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "workspacePresetMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workspacePreset" }
    },
    "workspacePreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "skills", "procedures", "intake", "artifactClasses"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "skills": { "$ref": "#/$defs/stringArray" },
        "procedures": { "$ref": "#/$defs/stringArray" },
        "intake": { "type": "object" },
        "artifactClasses": { "$ref": "#/$defs/stringArray" },
        "hooks": { "type": "object" },
        "toneDefaults": { "type": "object" },
        "researchProfiles": { "type": "object" },
        "rebrand": { "type": "object" },
        "capabilities": { "type": "object" },
        "experimental": { "type": "boolean" }
      }
    },
    "workerProfileMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workerProfile" }
    },
    "workerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "runtime", "modelTier", "reasoningEffort", "skillEmphasis", "procedureAffinity", "capabilities", "policyFence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "runtime": { "enum": ["host-agent", "provider", "process", "acp"] },
        "modelTier": { "enum": ["strong", "standard", "cheap"] },
        "reasoningEffort": { "enum": ["low", "medium", "high"] },
        "skillEmphasis": { "$ref": "#/$defs/stringArray" },
        "procedureAffinity": { "$ref": "#/$defs/stringArray" },
        "capabilities": { "$ref": "#/$defs/stringArray" },
        "policyFence": { "type": "object" },
        "events": { "$ref": "#/$defs/stringArray" },
        "artifactClasses": { "$ref": "#/$defs/stringArray" },
        "watchConditions": { "type": "array" },
        "permissions": { "type": "object" },
        "participationRules": { "type": ["array", "object"] },
        "toolGrants": { "$ref": "#/$defs/stringArray" },
        "webAccess": { "type": "boolean" },
        "manualOnly": { "type": "boolean" }
      }
    },
    "procedureMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/procedure" }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "type", "workerProfiles", "approvalMode", "modelTier", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "workerProfiles": { "$ref": "#/$defs/stringArray" },
        "approvalMode": { "enum": ["proposal-only", "requires-human-approval", "allow-durable-write"] },
        "modelTier": { "enum": ["strong", "standard", "cheap"] },
        "state": { "enum": ["defined", "active", "retired", "removed"] },
        "modes": { "$ref": "#/$defs/stringArray" },
        "surfaces": { "$ref": "#/$defs/stringArray" },
        "description": { "type": "string" },
        "outputSchema": { "type": "object" },
        "durableStateModel": { "type": "string" },
        "intakeType": { "type": "string" },
        "embed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerProfileId", "providerBindings", "framework", "outputContract", "proposalAuthority", "runtime"],
          "properties": {
            "workerProfileId": { "$ref": "#/$defs/id" },
            "providerBindings": { "$ref": "#/$defs/stringArray" },
            "framework": { "$ref": "#/$defs/id" },
            "outputContract": { "$ref": "#/$defs/id" },
            "proposalAuthority": { "enum": ["propose-only", "governed-write"] },
            "runtime": { "enum": ["in-process", "external", "auto", "none"] },
            "cadence": { "type": "object" },
            "filter": { "type": "object" }
          }
        }
      }
    },
    "capabilityMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/capability" }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "criticality", "ownerWorkerProfiles", "requiredSkills", "requiredProcedures", "contracts", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "criticality": { "enum": ["P0", "P1", "P2", "P3"] },
        "ownerWorkerProfiles": { "$ref": "#/$defs/stringArray" },
        "requiredSkills": { "$ref": "#/$defs/stringArray" },
        "requiredProcedures": { "$ref": "#/$defs/stringArray" },
        "contracts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/capabilityContract" }
        },
        "state": { "enum": ["declared", "active", "retired", "removed"] },
        "surfaces": { "type": "object" },
        "verification": { "type": "object" },
        "humanGate": { "type": "string" },
        "lastValidated": { "type": "string" }
      }
    },
    "capabilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer", "consumer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "producer": { "type": "string", "minLength": 1 },
        "consumer": { "type": "string", "minLength": 1 },
        "trigger": { "type": "object" },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "preconditions": { "type": "array" },
        "postconditions": { "type": "array" },
        "description": { "type": "string" },
        "skillHints": { "$ref": "#/$defs/stringArray" }
      }
    },
    "policyMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/policy" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerWorkerProfile", "description", "enforcement", "mode", "approvalWorkerProfiles", "requiredPolicies", "vetoWorkerProfiles", "escalationWorkerProfiles", "governs", "conditions", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ownerWorkerProfile": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enforcement": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "approvalWorkerProfiles": { "$ref": "#/$defs/stringArray" },
        "requiredPolicies": { "$ref": "#/$defs/stringArray" },
        "vetoWorkerProfiles": { "$ref": "#/$defs/stringArray" },
        "escalationWorkerProfiles": { "$ref": "#/$defs/stringArray" },
        "governs": { "$ref": "#/$defs/stringArray" },
        "conditions": { "type": "array" },
        "evidence": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
