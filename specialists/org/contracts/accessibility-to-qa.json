{
  "id": "accessibility-to-qa",
  "producer": "cx-accessibility",
  "consumer": "cx-qa",
  "trigger": {
    "riskFlags": [
      "ui",
      "accessibility"
    ]
  },
  "input": {
    "shape": "a11y-findings",
    "mustContain": [
      "findings",
      "wcagCriterion",
      "userImpact"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/test-report.json",
    "type": "test-report"
  },
  "preconditions": [
    "A11y findings filed against specific elements (file:line) before QA verification"
  ],
  "postconditions": [
    {
      "id": "accessibility-to-qa-pc-0-qa-test-plan-covers-keyboard-only",
      "description": "QA test plan covers keyboard-only and screen-reader paths for each finding",
      "postconditionType": "advisory"
    },
    {
      "id": "accessibility-to-qa-pc-1-findings-flagged-unverified-by-accessibility-get",
      "description": "Findings flagged 'unverified' by accessibility get a verified test in QA before close",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "product-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
