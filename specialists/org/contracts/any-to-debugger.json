{
  "id": "any-to-debugger",
  "producer": "*",
  "consumer": "cx-debugger",
  "trigger": {
    "intent": "investigation",
    "category": "bug"
  },
  "input": {
    "shape": "bug-signal",
    "mustContain": [
      "symptoms",
      "scope"
    ]
  },
  "output": {
    "shape": "root-cause-report",
    "mustContain": [
      "rootCause",
      "rootCauseConfirmedVia",
      "fix"
    ],
    "mustMatchEnum": {
      "rootCauseConfirmedVia": [
        "reproduction",
        "trace",
        "test"
      ]
    }
  },
  "preconditions": [
    "Bug reproduced or trace captured before proposing a fix"
  ],
  "postconditions": [
    {
      "id": "any-to-debugger-pc-0-rootcauseconfirmedvia-in-reproduction-trace-test-prevents",
      "description": "rootCauseConfirmedVia in {reproduction, trace, test} — prevents symptom-only fixes that don't address the actual cause",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "rootCauseConfirmedVia"
    }
  ],
  "description": ""
}
