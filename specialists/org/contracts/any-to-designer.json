{
  "id": "any-to-designer",
  "producer": "*",
  "consumer": "cx-designer",
  "trigger": {
    "riskFlags": [
      "ui",
      "accessibility"
    ]
  },
  "input": {
    "shape": "design-brief",
    "mustContain": [
      "surface",
      "users",
      "context"
    ]
  },
  "output": {
    "shape": "design-deliverable",
    "mustContain": [
      "deliverable",
      "accessibilityCheckRan"
    ]
  },
  "preconditions": [
    "Affected surface scoped"
  ],
  "postconditions": [
    "accessibilityCheckRan=true — prevents post-hoc a11y fixes by forcing a pre-ship check on every design deliverable"
  ],
  "description": ""
}
