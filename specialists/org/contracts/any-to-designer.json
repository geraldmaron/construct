{
  "id": "any-to-designer",
  "producer": "*",
  "consumer": "designer",
  "trigger": {
    "riskFlags": [
      "ui",
      "accessibility"
    ]
  },
  "input": {
    "shape": "design-brief",
    "mustContain": [
      "surface",
      "users",
      "context"
    ]
  },
  "output": {
    "shape": "design-deliverable",
    "mustContain": [
      "deliverable",
      "accessibilityCheckRan"
    ]
  },
  "preconditions": [
    "Affected surface scoped"
  ],
  "postconditions": [
    {
      "id": "any-to-designer-pc-0-accessibilitycheckran-true-prevents-post-hoc-a11y",
      "description": "accessibilityCheckRan=true — prevents post-hoc a11y fixes by forcing a pre-ship check on every design deliverable",
      "postconditionType": "executable",
      "enforcedVia": "binary-postcondition",
      "enforcedBy": "designer.accessibility-check-ran"
    }
  ],
  "description": ""
}
