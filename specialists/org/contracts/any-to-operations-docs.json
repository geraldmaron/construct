{
  "id": "any-to-operations-docs",
  "producer": "*",
  "consumer": "cx-operations",
  "trigger": {
    "postConsumer": true,
    "changedCoreDocs": true
  },
  "input": {
    "shape": "doc-delta",
    "mustContain": [
      "filesChanged",
      "decision"
    ]
  },
  "output": {
    "shape": "doc-sync",
    "mustContain": [
      "updatedDocs",
      "crossReferencesAdded",
      "crossDocCoherenceCheckRan",
      "coherenceDiff"
    ]
  },
  "preconditions": [
    "Implementation or decision is marked DONE"
  ],
  "postconditions": [
    {
      "id": "any-to-operations-docs-pc-0-cross-doc-coherence-preserved-prd-adr",
      "description": "Cross-doc coherence preserved (PRD ↔ ADR ↔ code)",
      "postconditionType": "advisory"
    },
    {
      "id": "any-to-operations-docs-pc-1-auto-managed-regions-regenerated-via-construct",
      "description": "AUTO-managed regions regenerated via construct sync",
      "postconditionType": "advisory"
    },
    {
      "id": "any-to-operations-docs-pc-2-crossdoccoherencecheckran-true-with-a-named-coherencediff",
      "description": "crossDocCoherenceCheckRan=true with a named coherenceDiff — prevents stale-doc PRs that claim 'docs updated' without a real diff",
      "postconditionType": "executable",
      "enforcedVia": "binary-postcondition",
      "enforcedBy": "docs-keeper.cross-doc-coherence-check-ran"
    }
  ],
  "description": ""
}
