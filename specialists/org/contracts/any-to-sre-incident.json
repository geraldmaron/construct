{
  "id": "any-to-sre-incident",
  "producer": "*",
  "consumer": "cx-operations",
  "trigger": {
    "intent": "investigation",
    "category": "incident"
  },
  "input": {
    "shape": "incident-signal",
    "mustContain": [
      "symptoms",
      "scope",
      "firstObserved"
    ]
  },
  "output": {
    "shape": "incident-report",
    "mustContain": [
      "rootCause",
      "timeline",
      "remediation",
      "preventions"
    ]
  },
  "preconditions": [
    "Blast radius assessed before remediation"
  ],
  "postconditions": [
    {
      "id": "any-to-sre-incident-pc-0-blameless-postmortem-no-tickets-in-problem",
      "description": "Blameless postmortem; no tickets in Problem statement",
      "postconditionType": "advisory"
    }
  ],
  "description": ""
}
