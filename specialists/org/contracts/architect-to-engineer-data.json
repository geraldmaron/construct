{
  "id": "architect-to-engineer-data",
  "producer": "cx-architect",
  "consumer": "cx-engineer",
  "trigger": {
    "riskFlags": [
      "data",
      "pipeline"
    ],
    "intent": [
      "implementation"
    ]
  },
  "input": {
    "schema": "lib/contract-schemas/decision.json",
    "mustContain": [
      "goal",
      "approach",
      "dataContracts"
    ]
  },
  "output": {
    "shape": "pipeline-spec",
    "mustContain": [
      "dataContract",
      "schema",
      "qualityGates",
      "retryPolicy"
    ]
  },
  "preconditions": [
    "Data volume, latency requirements, and existing stack clarified before architecture proposed",
    "Existing schema inspected; column names and table relationships not invented"
  ],
  "postconditions": [
    {
      "id": "architect-to-engineer-data-pc-0-pipeline-is-idempotent-and-observable-not",
      "description": "Pipeline is idempotent and observable; not running on faith",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-engineer-data-pc-1-data-contract-is-written-down-quality",
      "description": "Data contract is written down; quality gates defined as part of the design",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "dataContract, qualityGates"
    },
    {
      "id": "pipeline-spec-has-idempotency-plan",
      "description": "Pipeline spec must contain an Idempotency Plan section",
      "check": "artifact-has-section",
      "section": "Idempotency Plan",
      "postconditionType": "executable"
    },
    {
      "id": "pipeline-spec-has-observability",
      "description": "Pipeline spec must contain an Observability section",
      "check": "artifact-has-section",
      "section": "Observability",
      "postconditionType": "executable"
    }
  ],
  "description": ""
}
