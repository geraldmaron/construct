{
  "id": "architect-to-engineer-platform",
  "producer": "architect",
  "consumer": "engineer",
  "trigger": {
    "riskFlags": [
      "platform",
      "infrastructure"
    ],
    "intent": [
      "implementation"
    ]
  },
  "input": {
    "schema": "lib/contract-schemas/decision.json",
    "mustContain": [
      "goal",
      "approach",
      "platformDependencies"
    ]
  },
  "output": {
    "shape": "platform-plan",
    "mustContain": [
      "problem",
      "solution",
      "impact",
      "migration",
      "rollback"
    ]
  },
  "preconditions": [
    "Observed friction quantified; not hypothetical future problems",
    "Existing CI/CD and tooling surveyed before proposing new tooling"
  ],
  "postconditions": [
    {
      "id": "architect-to-engineer-platform-pc-0-migration-path-described-for-existing-workflows",
      "description": "Migration path described for existing workflows",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "migration"
    },
    {
      "id": "architect-to-engineer-platform-pc-1-rollback-procedure-exists-in-case-the",
      "description": "Rollback procedure exists in case the change makes things worse",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "rollback"
    },
    {
      "id": "architect-to-engineer-platform-pc-2-improvement-removes-more-configuration-than-it",
      "description": "Improvement removes more configuration than it adds, or the added config is justified",
      "postconditionType": "advisory"
    }
  ],
  "description": ""
}
