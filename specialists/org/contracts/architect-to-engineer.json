{
  "id": "architect-to-engineer",
  "producer": "architect",
  "consumer": "engineer",
  "trigger": {
    "intent": [
      "implementation",
      "fix"
    ]
  },
  "input": {
    "schema": "lib/contract-schemas/decision.json",
    "mustContain": [
      "goal",
      "approach",
      "tasks",
      "acceptanceCriteria",
      "constraintMap",
      "optionScoring"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/implementation.json",
    "type": "implementation"
  },
  "preconditions": [
    "ADR approved (or fast-track noted); no pending CRITICAL review findings",
    "Task packet contains readFirst and doNotChange lists"
  ],
  "postconditions": [
    {
      "id": "architect-to-engineer-pc-0-implementation-cites-the-adr-tasks-it",
      "description": "Implementation cites the ADR tasks it completed",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-engineer-pc-1-fileschanged-matches-tasks-in-the-adr",
      "description": "filesChanged matches tasks in the ADR",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-engineer-pc-2-verificationchecklist-evaluated-before-done",
      "description": "verificationChecklist evaluated before DONE",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "verificationChecklist (nested schema required)"
    }
  ],
  "description": ""
}
