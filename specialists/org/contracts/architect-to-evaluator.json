{
  "id": "architect-to-evaluator",
  "producer": "cx-architect",
  "consumer": "cx-reviewer",
  "trigger": {
    "riskFlags": [
      "ai",
      "quality"
    ],
    "intent": [
      "implementation"
    ]
  },
  "input": {
    "schema": "lib/contract-schemas/decision.json",
    "mustContain": [
      "goal",
      "approach",
      "evalCriteria"
    ]
  },
  "output": {
    "shape": "eval-spec",
    "mustContain": [
      "evaluationCriteria",
      "scoringRubric",
      "testCases",
      "comparisonProtocol",
      "passFailThreshold"
    ]
  },
  "preconditions": [
    "What 'better' means is defined in writing before the work is done",
    "Baseline run identified or scheduled before proposed change runs"
  ],
  "postconditions": [
    {
      "id": "architect-to-evaluator-pc-0-failing-case-is-defined-before-results",
      "description": "Failing case is defined before results are seen",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-evaluator-pc-1-regression-checks-enumerated-not-just-success",
      "description": "Regression checks enumerated; not just success-path test cases",
      "postconditionType": "advisory"
    },
    {
      "id": "eval-spec-has-success-criteria",
      "description": "Eval spec must contain a Success Criteria section",
      "check": "artifact-has-section",
      "section": "Success Criteria",
      "postconditionType": "executable"
    },
    {
      "id": "eval-spec-has-baseline",
      "description": "Eval spec must contain a Baseline section",
      "check": "artifact-has-section",
      "section": "Baseline",
      "postconditionType": "executable"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
