{
  "id": "architect-to-operations",
  "producer": "architect",
  "consumer": "operations",
  "trigger": {
    "intent": [
      "implementation"
    ],
    "workCategory": "deep"
  },
  "input": {
    "schema": "lib/contract-schemas/decision.json",
    "mustContain": [
      "goal",
      "approach",
      "tasks",
      "acceptanceCriteria"
    ]
  },
  "output": {
    "shape": "ops-plan",
    "mustContain": [
      "sequencedTasks",
      "dependencyGraph",
      "ownershipMatrix",
      "verificationGates",
      "slippageRisk"
    ]
  },
  "preconditions": [
    "Architect plan and devil-advocate feedback resolved",
    "Tasks are atomic and individually verifiable"
  ],
  "postconditions": [
    {
      "id": "architect-to-operations-pc-0-every-task-names-a-single-owner",
      "description": "Every task names a single owner",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-operations-pc-1-every-task-names-a-verification-gate",
      "description": "Every task names a verification gate and definition-of-done",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-operations-pc-2-dependency-graph-identifies-blockers-no-task",
      "description": "Dependency graph identifies blockers; no task lies on a hidden critical path",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "operations-group",
    "requiresApprovalFrom": []
  }
}
