{
  "id": "architect-to-reviewer-challenge",
  "producer": "architect",
  "consumer": "reviewer",
  "trigger": {
    "framingChallenge.required": true
  },
  "input": {
    "shape": "framing-proposal",
    "mustContain": [
      "problemStatement",
      "proposedApproach",
      "assumptions"
    ]
  },
  "output": {
    "shape": "challenge-report",
    "mustContain": [
      "verdict",
      "counterevidence",
      "reframingProposals"
    ]
  },
  "preconditions": [
    "Problem statement stated independent of tickets/transcripts"
  ],
  "postconditions": [
    {
      "id": "architect-to-reviewer-challenge-pc-0-if-verdict-is-blocked-architect-revises",
      "description": "If verdict is BLOCKED, architect revises framing before proceeding",
      "postconditionType": "advisory"
    },
    {
      "id": "architect-to-reviewer-challenge-pc-1-challenge-checkpoint-logged-to-audit-trail",
      "description": "Challenge checkpoint logged to audit trail",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
