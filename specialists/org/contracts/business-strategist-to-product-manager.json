{
  "id": "business-strategist-to-product-manager",
  "producer": "cx-business-strategist",
  "consumer": "cx-product-manager",
  "trigger": {
    "strategy.required": true
  },
  "input": {
    "shape": "strategic-memo",
    "mustContain": [
      "strategicContext",
      "recommendation",
      "evidence"
    ]
  },
  "output": {
    "shape": "prd-handoff",
    "mustContain": [
      "problem",
      "users",
      "functionalRequirements",
      "acceptanceCriteria"
    ]
  },
  "preconditions": [
    "Strategic memo signed off; recommended option carried into PRD framing"
  ],
  "postconditions": [
    {
      "id": "business-strategist-to-product-manager-pc-0-prd-problem-statement-traces-to-the",
      "description": "PRD Problem statement traces to the strategic memo's market context, not to internal roadmap items",
      "postconditionType": "advisory"
    },
    {
      "id": "business-strategist-to-product-manager-pc-1-prd-acknowledges-the-competitive-dynamic-named",
      "description": "PRD acknowledges the competitive dynamic named in the strategic memo",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "strategy-group",
    "consumerTeam": "product-group",
    "requiresApprovalFrom": []
  }
}
