{
  "id": "data-analyst-to-product-manager",
  "producer": "cx-data-analyst",
  "consumer": "cx-product-manager",
  "trigger": {
    "docAuthoring.docType": [
      "prd",
      "meta-prd"
    ],
    "riskFlags": [
      "metrics"
    ]
  },
  "input": {
    "shape": "metrics-analysis",
    "mustContain": [
      "metricDefinition",
      "baseline",
      "successThreshold"
    ]
  },
  "output": {
    "shape": "prd-handoff",
    "mustContain": [
      "acceptanceCriteria",
      "successMetrics"
    ]
  },
  "preconditions": [
    "Metric definition reviewed for vanity-metric risk and for hit-without-solving-the-problem risk"
  ],
  "postconditions": [
    {
      "id": "data-analyst-to-product-manager-pc-0-prd-success-metrics-carry-the-cited",
      "description": "PRD success metrics carry the cited baseline and threshold from the analysis",
      "postconditionType": "executable",
      "check": "artifact-claims-cited"
    },
    {
      "id": "data-analyst-to-product-manager-pc-1-metrics-that-can-be-hit-without",
      "description": "Metrics that can be hit without solving the problem are flagged and replaced",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "strategy-group",
    "consumerTeam": "product-group",
    "requiresApprovalFrom": []
  }
}
