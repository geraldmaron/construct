{
  "id": "designer-to-accessibility",
  "producer": "cx-designer",
  "consumer": "cx-accessibility",
  "trigger": {
    "riskFlags": [
      "ui",
      "accessibility"
    ]
  },
  "input": {
    "shape": "design-deliverable",
    "mustContain": [
      "surface",
      "deliverable",
      "accessibilityCheckRan"
    ]
  },
  "output": {
    "shape": "a11y-findings",
    "mustContain": [
      "findings",
      "wcagCriterion",
      "userImpact",
      "fix"
    ]
  },
  "preconditions": [
    "Flow exercised with a keyboard and a screen reader; not just spec-read"
  ],
  "postconditions": [
    {
      "id": "designer-to-accessibility-pc-0-every-finding-cites-a-wcag-criterion",
      "description": "Every finding cites a WCAG criterion and a concrete repro step",
      "postconditionType": "advisory"
    },
    {
      "id": "designer-to-accessibility-pc-1-findings-that-weren-t-exercised-with",
      "description": "Findings that weren't exercised with the assistive technology are labeled 'unverified'",
      "postconditionType": "advisory"
    }
  ],
  "description": ""
}
