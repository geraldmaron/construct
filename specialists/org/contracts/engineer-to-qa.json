{
  "id": "engineer-to-qa",
  "producer": "engineer",
  "consumer": "qa",
  "trigger": {
    "always": true
  },
  "input": {
    "schema": "lib/contract-schemas/implementation.json",
    "mustContain": [
      "filesChanged",
      "tests",
      "effortClass",
      "blastRadius"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/test-report.json",
    "type": "test-report"
  },
  "preconditions": [
    "Test plan exists or is derivable from acceptance criteria"
  ],
  "postconditions": [
    {
      "id": "engineer-to-qa-pc-0-verdict-in-pass-fail",
      "description": "Verdict in {PASS, FAIL}",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "verdict (schema enum)"
    },
    {
      "id": "engineer-to-qa-pc-1-coverage-meets-project-threshold",
      "description": "Coverage meets project threshold",
      "postconditionType": "advisory"
    },
    {
      "id": "engineer-to-qa-pc-2-fail-blocks-done-in-workflow",
      "description": "FAIL blocks DONE in workflow",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
