{
  "id": "engineer-to-reviewer",
  "producer": "cx-engineer",
  "consumer": "cx-reviewer",
  "trigger": {
    "always": true
  },
  "input": {
    "schema": "lib/contract-schemas/implementation.json",
    "mustContain": [
      "filesChanged",
      "verificationChecklist",
      "feasibilityAssessment",
      "effortClass",
      "debtNote",
      "blastRadius"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/review-report.json",
    "type": "review-report",
    "mustContain": [
      "verdict"
    ],
    "mustContainOneOf": [
      [
        "findings",
        "noIssuesFoundAt"
      ]
    ],
    "mustMatchEnum": {
      "verdict": [
        "APPROVED",
        "APPROVED_WITH_WARNINGS",
        "BLOCKED"
      ]
    }
  },
  "preconditions": [
    "Engineer status is not BLOCKED",
    "Tests compiled; static analysis run"
  ],
  "postconditions": [
    {
      "id": "engineer-to-reviewer-pc-0-verdict-in-approved-approved-with-warnings",
      "description": "Verdict in {APPROVED, APPROVED_WITH_WARNINGS, BLOCKED}",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "verdict (mustMatchEnum)"
    },
    {
      "id": "engineer-to-reviewer-pc-1-blocked-verdict-stops-downstream-work-until",
      "description": "BLOCKED verdict stops downstream work until addressed",
      "postconditionType": "advisory"
    },
    {
      "id": "engineer-to-reviewer-pc-2-critical-findings-prevent-release",
      "description": "CRITICAL findings prevent release",
      "postconditionType": "advisory"
    },
    {
      "id": "engineer-to-reviewer-pc-3-either-findings-is-non-empty-or",
      "description": "Either findings is non-empty or noIssuesFoundAt enumerates the inspected paths — prevents silent rubber-stamp reviews",
      "postconditionType": "executable",
      "enforcedVia": "output-shape",
      "enforcedBy": "findings|noIssuesFoundAt (mustContainOneOf)"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
