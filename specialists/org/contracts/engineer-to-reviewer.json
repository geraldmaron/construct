{
  "id": "engineer-to-reviewer",
  "producer": "cx-engineer",
  "consumer": "cx-reviewer",
  "trigger": {
    "always": true
  },
  "input": {
    "schema": "lib/contract-schemas/implementation.json",
    "mustContain": [
      "filesChanged",
      "verificationChecklist",
      "feasibilityAssessment",
      "effortClass",
      "debtNote",
      "blastRadius"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/review-report.json",
    "type": "review-report",
    "mustContain": [
      "verdict"
    ],
    "mustContainOneOf": [
      [
        "findings",
        "noIssuesFoundAt"
      ]
    ],
    "mustMatchEnum": {
      "verdict": [
        "APPROVED",
        "APPROVED_WITH_WARNINGS",
        "BLOCKED"
      ]
    }
  },
  "preconditions": [
    "Engineer status is not BLOCKED",
    "Tests compiled; static analysis run"
  ],
  "postconditions": [
    "Verdict in {APPROVED, APPROVED_WITH_WARNINGS, BLOCKED}",
    "BLOCKED verdict stops downstream work until addressed",
    "CRITICAL findings prevent release",
    "Either findings is non-empty or noIssuesFoundAt enumerates the inspected paths — prevents silent rubber-stamp reviews"
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "engineering-group",
    "consumerTeam": "quality-group",
    "requiresApprovalFrom": []
  }
}
