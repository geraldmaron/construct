{
  "id": "product-manager-to-architect",
  "producer": "cx-product-manager",
  "consumer": "cx-architect",
  "trigger": {
    "docAuthoring.docType": [
      "prd",
      "meta-prd",
      "adr",
      "rfc"
    ]
  },
  "input": {
    "shape": "prd-handoff",
    "mustContain": [
      "problem",
      "functionalRequirements",
      "nonFunctionalRequirements",
      "acceptanceCriteria",
      "constraints",
      "valueStatement",
      "tradeoffTable",
      "prioritizationCall"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/decision.json",
    "type": "decision"
  },
  "preconditions": [
    "cx-devil-advocate framing challenge logged if riskFlags.architecture"
  ],
  "postconditions": [
    {
      "id": "product-manager-to-architect-pc-0-adr-problem-section-traces-to-prd",
      "description": "ADR Problem section traces to PRD Problem, not to tickets",
      "postconditionType": "advisory"
    },
    {
      "id": "product-manager-to-architect-pc-1-adr-rejected-alternatives-section-present-with",
      "description": "ADR Rejected alternatives section present with ≥2 alternatives and specific rejection reasons",
      "postconditionType": "advisory"
    },
    {
      "id": "product-manager-to-architect-pc-2-reversibility-section-states-whether-one-way",
      "description": "Reversibility section states whether one-way or two-way door",
      "postconditionType": "advisory"
    },
    {
      "id": "adr-has-rejected-alternatives",
      "description": "ADR must contain a Rejected Alternatives section",
      "check": "artifact-has-section",
      "section": "Rejected Alternatives",
      "postconditionType": "executable"
    },
    {
      "id": "adr-reversibility-stated",
      "description": "ADR Reversibility section is present and non-empty",
      "check": "artifact-section-nonempty",
      "section": "Reversibility",
      "postconditionType": "executable"
    },
    {
      "id": "adr-consequences-stated",
      "description": "ADR Consequences section is present and non-empty",
      "check": "artifact-section-nonempty",
      "section": "Consequences",
      "postconditionType": "executable"
    },
    {
      "id": "adr-numeric-claims-cited",
      "description": "Every numeric claim in the ADR body cites a source",
      "check": "artifact-claims-cited",
      "postconditionType": "executable"
    },
    {
      "id": "adr-manifest-reviewers",
      "description": "Manifest required reviewers must appear in agent log before handoff",
      "check": "artifact-reviewers-seen",
      "fromManifest": true,
      "postconditionType": "executable"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "product-group",
    "consumerTeam": "engineering-group",
    "requiresApprovalFrom": []
  }
}
