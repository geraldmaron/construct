{
  "id": "product-manager-to-data-analyst",
  "producer": "cx-product-manager",
  "consumer": "cx-data-analyst",
  "trigger": {
    "docAuthoring.docType": [
      "prd",
      "meta-prd"
    ],
    "riskFlags": [
      "metrics"
    ]
  },
  "input": {
    "shape": "metrics-request",
    "mustContain": [
      "successDefinition",
      "decisionPending"
    ]
  },
  "output": {
    "shape": "metrics-analysis",
    "mustContain": [
      "metricDefinition",
      "baseline",
      "successThreshold",
      "dataQualityCaveats"
    ]
  },
  "preconditions": [
    "Success definition stated in writing before metric design begins"
  ],
  "postconditions": [
    "Every percentage, multiplier, or magnitude cites the query, dashboard, or run that produced it",
    "Baseline is a measured value or names the plan to establish one",
    {
      "id": "metrics-analysis-claims-cited",
      "description": "Every numeric claim in the analysis cites the query or dashboard",
      "check": "artifact-claims-cited"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "product-group",
    "consumerTeam": "strategy-group",
    "requiresApprovalFrom": []
  }
}
