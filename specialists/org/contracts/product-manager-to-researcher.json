{
  "id": "product-manager-to-researcher",
  "producer": "product-manager",
  "consumer": "researcher",
  "trigger": {
    "docAuthoring.docType": [
      "prd",
      "meta-prd",
      "prfaq"
    ],
    "riskFlags": [
      "ux"
    ]
  },
  "input": {
    "shape": "ux-research-request",
    "mustContain": [
      "surface",
      "userQuestion",
      "decisionPending"
    ]
  },
  "output": {
    "shape": "ux-brief",
    "mustContain": [
      "userProfiles",
      "jobsToBeDone",
      "frictionMap",
      "assumptionsLog"
    ]
  },
  "preconditions": [
    "PRD has an open user-research question; PRD not finalized"
  ],
  "postconditions": [
    {
      "id": "product-manager-to-researcher-pc-0-every-friction-map-entry-cites-the",
      "description": "Every friction-map entry cites the observation or session it came from",
      "postconditionType": "advisory"
    },
    {
      "id": "product-manager-to-researcher-pc-1-stated-preferences-are-labeled-distinctly-from",
      "description": "Stated preferences are labeled distinctly from observed behaviors",
      "postconditionType": "advisory"
    },
    {
      "id": "ux-research-has-sources-section",
      "description": "UX research artifact must contain a Sources section",
      "check": "artifact-has-section",
      "section": "Sources",
      "postconditionType": "executable"
    },
    {
      "id": "ux-research-claims-cited",
      "description": "Every numeric or generalization claim in the UX brief cites the research source",
      "check": "artifact-claims-cited",
      "postconditionType": "executable"
    }
  ],
  "description": ""
}
