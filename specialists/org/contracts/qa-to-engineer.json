{
  "id": "qa-to-engineer",
  "producer": "cx-qa",
  "consumer": "cx-engineer",
  "trigger": {
    "automation.required": true
  },
  "input": {
    "shape": "automation-plan",
    "mustContain": [
      "framework",
      "coverageTargets",
      "flakeBudget"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/implementation.json",
    "type": "implementation"
  },
  "preconditions": [
    "Test scaffolding lands before behavioral edits so the test fails for the right reason first"
  ],
  "postconditions": [
    {
      "id": "qa-to-engineer-pc-0-engineer-adds-at-least-one-failing",
      "description": "Engineer adds at least one failing test that demonstrates the bug or missing behavior before implementing the fix",
      "postconditionType": "advisory"
    },
    {
      "id": "qa-to-engineer-pc-1-quarantined-flaky-tests-carry-an-owner",
      "description": "Quarantined flaky tests carry an owner and a remediation date",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "quality-group",
    "consumerTeam": "engineering-group",
    "requiresApprovalFrom": []
  }
}
