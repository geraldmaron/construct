{
  "id": "qa-to-operations",
  "producer": "qa",
  "consumer": "operations",
  "trigger": {
    "intent": [
      "implementation"
    ],
    "workCategory": "deep"
  },
  "input": {
    "schema": "lib/contract-schemas/test-report.json",
    "mustContain": [
      "verdict",
      "passed",
      "failed",
      "coverage"
    ]
  },
  "output": {
    "shape": "release-decision",
    "mustContain": [
      "decision",
      "rolloutPlan",
      "rollbackPlan"
    ]
  },
  "preconditions": [
    "All upstream verdicts APPROVED; QA verdict PASS"
  ],
  "postconditions": [
    {
      "id": "qa-to-operations-pc-0-rollback-plan-tested-not-just-described",
      "description": "Rollback plan tested, not just described",
      "postconditionType": "advisory"
    },
    {
      "id": "qa-to-operations-pc-1-rollout-plan-has-concrete-checkpoint-signals",
      "description": "Rollout plan has concrete checkpoint signals",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "quality-group",
    "consumerTeam": "operations-group",
    "requiresApprovalFrom": []
  }
}
