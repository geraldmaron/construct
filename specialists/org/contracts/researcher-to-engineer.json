{
  "id": "researcher-to-engineer",
  "producer": "cx-researcher",
  "consumer": "cx-engineer",
  "trigger": {
    "intent": [
      "implementation",
      "fix"
    ],
    "explorer.findingsReady": true
  },
  "input": {
    "shape": "exploration-findings",
    "mustContain": [
      "entryPoints",
      "keyFiles",
      "gaps"
    ]
  },
  "output": {
    "schema": "lib/contract-schemas/implementation.json",
    "type": "implementation"
  },
  "preconditions": [
    "Exploration findings reviewed; gaps and surprising dependencies surfaced"
  ],
  "postconditions": [
    {
      "id": "researcher-to-engineer-pc-0-implementation-reads-the-files-cited-in",
      "description": "Implementation reads the files cited in keyFiles before edits",
      "postconditionType": "advisory"
    },
    {
      "id": "researcher-to-engineer-pc-1-gaps-named-by-explorer-missing-tests",
      "description": "Gaps named by explorer (missing tests, missing error handling) are addressed or filed",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "strategy-group",
    "consumerTeam": "engineering-group",
    "requiresApprovalFrom": []
  }
}
