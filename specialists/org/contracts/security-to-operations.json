{
  "id": "security-to-operations",
  "producer": "cx-security",
  "consumer": "cx-operations",
  "trigger": {
    "riskFlags": [
      "compliance"
    ],
    "intent": [
      "implementation"
    ]
  },
  "input": {
    "shape": "compliance-memo",
    "mustContain": [
      "risks",
      "severity",
      "remediation"
    ]
  },
  "output": {
    "shape": "release-decision",
    "mustContain": [
      "decision",
      "rolloutPlan",
      "rollbackPlan"
    ]
  },
  "preconditions": [
    "All must-fix compliance items closed or accepted in writing by the release owner"
  ],
  "postconditions": [
    {
      "id": "security-to-operations-pc-0-release-blocks-if-any-must-fix",
      "description": "Release blocks if any must-fix item is unresolved",
      "postconditionType": "advisory"
    },
    {
      "id": "security-to-operations-pc-1-should-fix-items-carry-a-tracking",
      "description": "Should-fix items carry a tracking issue and an owner",
      "postconditionType": "advisory"
    }
  ],
  "description": "",
  "teamBoundary": {
    "crosses": true,
    "producerTeam": "governance-group",
    "consumerTeam": "operations-group",
    "requiresApprovalFrom": []
  }
}
