{
  "id": "sre-to-release-manager",
  "producer": "cx-sre",
  "consumer": "cx-release-manager",
  "trigger": {
    "riskFlags": [
      "dataIntegrity"
    ],
    "intent": [
      "implementation"
    ]
  },
  "input": {
    "shape": "sre-readiness",
    "mustContain": [
      "slos",
      "runbooks",
      "alerts",
      "dashboards"
    ]
  },
  "output": {
    "shape": "release-decision",
    "mustContain": [
      "decision",
      "rollbackPlan"
    ]
  },
  "preconditions": [
    "Runbook exists for the new code path; rollback procedure verified"
  ],
  "postconditions": [
    "On-call briefed; alert thresholds set"
  ],
  "description": ""
}
