{
  "$schema": "../../../schemas/scope.schema.json",
  "id": "operations",
  "displayName": "Operations",
  "tagline": "Request, triage, resolve, document, improve. Keep things running.",
  "intake": {
    "types": [
      "request",
      "bug",
      "incident",
      "ops",
      "security",
      "docs",
      "unknown"
    ],
    "stages": [
      "request",
      "triage",
      "resolve",
      "document",
      "improve"
    ],
    "classificationTable": "lib/intake/tables/operations.mjs"
  },
  "docTemplates": [
    "runbook",
    "incident-report",
    "memo",
    "one-pager",
    "changelog-entry"
  ],
  "hooks": {
    "sessionReflect": "on",
    "sessionOptimize": "on"
  },
  "defaultSkills": [],
  "toneDefaults": {
    "runbook": "blameless",
    "incident-report": "blameless",
    "memo": "direct"
  },
  "researchProfiles": {
    "incident": "codebase",
    "request": "external",
    "change": "codebase"
  },
  "rebrand": {
    "intakeQueueLabel": "Request queue",
    "signalNoun": "request"
  }
}
