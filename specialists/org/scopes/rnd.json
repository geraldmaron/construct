  },
  "researchProfiles": {
    "feature": "user",
    "bug": "codebase",
    "research": "external",
    "strategy": "market",
    "incident": "codebase"
  },
  "rebrand": {
    "intakeQueueLabel": "R&D intake queue",
    "signalNoun": "signal"
  },
  "capabilities": {
    "intake": {
      "inbox": true,
      "dedup": "sha256",
      "attribution": true
    }
  }
}
