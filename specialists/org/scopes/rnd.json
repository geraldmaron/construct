{
  "$schema": "../../../schemas/scope.schema.json",
  "id": "rnd",
  "displayName": "Software R&D",
  "tagline": "The default. Product, engineering, governance, operations under one persona.",
  "intake": {
    "types": [
      "user-signal",
      "bug",
      "requirement",
      "research",
      "experiment",
      "eval-finding",
      "architecture",
      "incident",
      "launch-asset",
      "ops",
      "security",
      "legal-compliance"
    ],
    "stages": [
      "signal",
      "framing",
      "hypothesis",
      "design",
      "implementation",
      "evaluation",
      "release",
      "operations"
    ],
    "classificationTable": "lib/intake/tables/rnd.mjs"
  },
  "docTemplates": [
    "prd",
    "prd-platform",
    "prd-business",
    "rfc",
    "rfc-platform",
    "adr",
    "prfaq",
    "research-brief",
    "evidence-brief",
    "signal-brief",
    "customer-profile",
    "runbook",
    "incident-report",
    "memo",
    "strategy",
    "one-pager",
    "changelog-entry"
