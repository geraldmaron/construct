{
  "name": "designer",
  "displayName": "Treats visual decisions as interaction decisions — a design that only exists in the happy state is incomplete.",
  "description": "Treats visual decisions as interaction decisions — a design that only exists in the happy state is incomplete.",
  "role": "designer",
  "modelTier": "standard",
  "reasoningEffort": "medium",
  "skills": [
    "frontend-design/ui-aesthetics",
    "frontend-design/ux-principles",
    "frontend-design/component-patterns",
    "frontend-design/state-management",
    "frontend-design/engineering",
    "frontend-design/accessibility",
    "frontend-design/screen-reader-testing"
  ],
  "events": [
    "design.requested",
    "a11y.violation"
  ],
  "fence": {
    "allowedPaths": [
      "docs/design/**",
      "docs/wireframes/**",
      "design/**",
      "docs/accessibility/**",
      "docs/a11y/**"
    ],
    "allowedBdLabels": [
      "design",
      "ux",
      "ui",
      "wireframe",
      "accessibility",
      "a11y"
    ],
    "allowedCommands": [
      "bd create",
      "bd note",
      "bd update",
      "bd label"
    ],
    "approvalRequired": [
      "commit",
      "push",
      "edit:lib/**",
      "edit:bin/**",
      "edit:src/**",
      "edit:app/**"
    ]
  },
  "docArtifacts": [],
  "watchConditions": [
    {
      "watcher": "visual-or-ui-risk",
      "reason": "visual deliverable / UI risk surface"
    }
  ],
  "permissions": {},
  "promptFile": "specialists/prompts/cx-designer.md",
  "embedOrientation": {
    "focusAreas": [
      "interaction completeness",
      "state coverage",
      "design consistency",
      "accessibility compliance",
      "keyboard navigability",
      "screen reader compatibility",
      "contrast compliance",
      "ARIA correctness"
    ],
    "riskSignals": [
      "missing error states",
      "no empty states",
      "inconsistent patterns",
      "untested responsive breakpoints",
      "ARIA added without testing",
      "keyboard traps",
      "contrast failures",
      "missing focus indicators"
    ],
    "artifactBias": [
      "notes",
      "memos"
    ]
  },
  "canEdit": true,
  "claudeTools": "Read,Grep,Glob,LS,Edit,Write,Bash,list_skills,get_skill,search_skills,get_template,list_templates,memory_search,memory_add_observations",
  "internal": true,
  "killSwitchEnv": "CONSTRUCT_ROLE_DESIGNER",
  "handoffCandidates": [
    "product-manager",
    "engineer",
    "qa"
  ],
  "team": "design-team",
  "teamId": "design-team",
  "groupId": "product-group"
}
