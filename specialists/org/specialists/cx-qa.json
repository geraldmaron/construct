{
  "name": "qa",
  "displayName": "Asks whether the tests test what matters — coverage numbers are hypotheses about quality, not proof of it.",
  "description": "Asks whether the tests test what matters — coverage numbers are hypotheses about quality, not proof of it.",
  "role": "qa",
  "modelTier": "standard",
  "reasoningEffort": "medium",
  "skills": [
    "devops/testing",
    "quality-gates/verify-change",
    "quality-gates/verify-module",
    "quality-gates/verify-quality",
    "quality-gates/review-work",
    "quality-gates/premortem"
  ],
  "events": [
    "test.fail",
    "test.flake",
    "coverage.drop"
  ],
  "fence": {
    "allowedPaths": [
      "docs/qa/**",
      "docs/test-plans/**",
      "tests/**",
      "docs/test-automation/**"
    ],
    "allowedBdLabels": [
      "bug",
      "qa",
      "test",
      "flake",
      "test-automation",
      "ci",
      "test-infra"
    ],
    "allowedCommands": [
      "bd create",
      "bd note",
      "bd update",
      "bd label"
    ],
    "approvalRequired": [
      "commit",
      "push",
      "edit:tests/**",
      "edit:lib/**",
      "edit:bin/**"
    ]
  },
  "docArtifacts": [
    "test-plan",
    "qa-strategy"
  ],
  "watchConditions": [],
  "permissions": {},
  "promptFile": "specialists/prompts/qa.md",
  "embedOrientation": {
    "focusAreas": [
      "test effectiveness",
      "behavioral coverage",
      "regression risk",
      "acceptance criteria traceability",
      "test determinism",
      "flakiness trends",
      "automation ROI"
    ],
    "riskSignals": [
      "tests that never fail",
      "coverage without behavioral assertions",
      "untested acceptance criteria",
      "flaky tests ignored",
      "arbitrary sleeps",
      "tests that never caught a bug",
      "intermittent failures dismissed"
    ],
    "artifactBias": [
      "notes"
    ]
  },
  "canEdit": true,
  "claudeTools": "Read,Grep,Glob,LS,Edit,Write,Bash,list_skills,get_skill,search_skills,memory_search,memory_add_observations,construct_trace,construct_score,get_template,list_templates",
  "internal": true,
  "killSwitchEnv": "CONSTRUCT_ROLE_QA",
  "handoffCandidates": [
    "engineer",
    "debugger"
  ],
  "team": "quality-team",
  "teamId": "quality-team",
  "groupId": "quality-group",
  "participationRules": {
    "schemaVersion": 1,
    "rules": [
      {
        "id": "wide-blast-test-coverage",
        "when": {
          "watchCondition": "wide-blast-radius"
        },
        "recruit": {
          "specialists": [
            "qa"
          ]
        },
        "role": "reviewer",
        "gate": "advisory",
        "reason": "wide blast radius — test coverage review"
      }
    ]
  }
}
