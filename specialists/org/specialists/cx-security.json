{
  "name": "security",
  "displayName": "Thinks like an attacker — sees the attack surface the developer didn't know existed.",
  "description": "Thinks like an attacker — sees the attack surface the developer didn't know existed.",
  "role": "security",
  "modelTier": "reasoning",
  "reasoningEffort": "high",
  "skills": [
    "security/red-team",
    "security/blue-team",
    "security/pentest",
    "security/code-audit",
    "security/vuln-research",
    "security/threat-intel",
    "quality-gates/verify-security",
    "architecture/security-arch",
    "compliance/license-audit",
    "compliance/data-privacy",
    "compliance/ai-disclosure",
    "compliance/regulatory-review"
  ],
  "events": [
    "dep.cve",
    "secrets.detected",
    "config.protection.violation",
    "dep.license",
    "privacy-policy.review"
  ],
  "fence": {
    "allowedPaths": [
      "docs/security/**",
      "docs/threat-models/**",
      "docs/legal/**",
      "docs/compliance/**",
      ".cx/knowledge/**"
    ],
    "allowedBdLabels": [
      "security",
      "vulnerability",
      "audit",
      "legal",
      "compliance",
      "privacy"
    ],
    "allowedCommands": [
      "bd create",
      "bd note",
      "bd update",
      "bd label"
    ],
    "approvalRequired": [
      "commit",
      "push",
      "edit:**"
    ]
  },
  "docArtifacts": [
    "security-review",
    "threat-model"
  ],
  "watchConditions": [
    {
      "watcher": "auth-payments-non-narrow",
      "reason": "pre-dispatch threat model (auth/payments/PII + non-narrow blast radius)"
    }
  ],
  "permissions": {},
  "promptFile": "specialists/prompts/cx-security.md",
  "embedOrientation": {
    "focusAreas": [
      "attack surface changes",
      "dependency vulnerabilities",
      "auth boundary integrity",
      "secret exposure",
      "license compliance",
      "data privacy posture",
      "AI disclosure obligations",
      "regulatory changes"
    ],
    "riskSignals": [
      "new unauthed endpoints",
      "unaudited dependencies",
      "implicit trust boundaries",
      "hardcoded credentials",
      "unreviewed dependency licenses",
      "undisclosed AI processing",
      "missing data basis documentation",
      "new jurisdiction exposure"
    ],
    "artifactBias": [
      "adrs",
      "notes"
    ]
  },
  "canEdit": false,
  "claudeTools": "Read,Grep,Glob,LS,Bash,WebSearch,WebFetch,list_skills,get_skill,search_skills,memory_search,memory_add_observations,cx_trace,cx_score,get_template,list_templates",
  "internal": true,
  "severityImmediate": [
    "dep.cve",
    "secrets.detected"
  ],
  "killSwitchEnv": "CONSTRUCT_ROLE_SECURITY",
  "handoffCandidates": [
    "engineer",
    "reviewer",
    "product-manager"
  ],
  "team": "governance-team",
  "teamId": "governance-team",
  "groupId": "governance-group"
}
