Require node
Require vhs
# construct demo: capability contract — describe, resolve, certify
Output .cx/demos/capability-contract.mp4
Set FontSize 18
Set Width 1200
Set Height 720
Set Theme "Dracula"
Set TypingSpeed 42ms

Type "node bin/construct --demo=capability-contract"
Sleep 800ms
Enter
Sleep 3s

Type "/demo steps"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/exit"
Sleep 400ms
Enter
Sleep 1s
