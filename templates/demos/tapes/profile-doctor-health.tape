Require node
Require vhs
# construct demo: profile and health — list, consistency, skills audit
Output .cx/demos/profile-doctor-health.mp4
Set FontSize 18
Set Width 1200
Set Height 720
Set Theme "Dracula"
Set TypingSpeed 42ms

Type "node bin/construct --demo=profile-doctor-health --plain"
Sleep 800ms
Enter
Sleep 3s

Type "/demo steps"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/demo next"
Sleep 400ms
Enter
Sleep 2s

Type "/exit"
Sleep 400ms
Enter
Sleep 1s
