{
  "schemaVersion": 2,
  "specialistId": "cx-operations",
  "capabilityId": "specialist.prompt",
  "mode": "normal",
  "scenarioKind": "happy-path-representative",
  "representativeTask": {
    "prompt": "Sequence the rollout of these four dependent changes — a schema migration, an API version bump, the client SDK update, and a feature-flag flip — and name the owner and rollback for each.",
    "inputs": {
      "changes": ["schema migration", "API version bump", "client SDK update", "feature-flag flip"]
    }
  },
  "expectedBehavior": {
    "mustContainAny": ["dependency", "sequence", "owner", "rollback", "runbook"],
    "mustNotContain": ["ship all four at once", "rollback not needed"],
    "mustRefuse": false,
    "mustEscalateTo": [],
    "mustStateAssumptions": true
  }
}
