      "surface": "auth / session",
      "change": "JWT session token + password-reset endpoint"
    }
  },
  "expectedBehavior": {
    "mustContainAny": ["attack surface", "threat", "auth", "secret", "boundary", "injection", "severity"],
    "mustNotContain": ["no hardcoded secrets, looks fine"],
    "mustRefuse": false,
    "mustEscalateTo": [],
    "mustStateAssumptions": true
  }
}
