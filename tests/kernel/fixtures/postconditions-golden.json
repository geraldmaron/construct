{
  "producers": {
    "reviewer": [
      {
        "id": "reviewer.findings-or-explicit-clear",
        "description": "Reviewer must either return at least one finding or explicitly state \"no issues found at: <paths>\"."
      }
    ],
    "security": [
      {
        "id": "security.threat-model-not-post-hoc",
        "description": "Threat model must be updated at or after the contract start (not retrofitted)."
      }
    ],
    "debugger": [
      {
        "id": "debugger.root-cause-confirmed-via",
        "description": "Root cause must be confirmed via reproduction, trace, or test (not inferred)."
      }
    ],
    "operations": [
      {
        "id": "docs-keeper.cross-doc-coherence-check-ran",
        "description": "Docs-keeper must run the cross-doc coherence check and attach a named diff."
      }
    ],
    "designer": [
      {
        "id": "designer.accessibility-check-ran",
        "description": "Designer must run the accessibility check before handoff (no post-hoc a11y)."
      }
    ],
    "engineer": []
  },
  "cases": [
    {
      "name": "reviewer — findings present",
      "producer": "reviewer",
      "packet": {
        "findings": [
          {
            "id": "f1"
          }
        ]
      },
      "result": {
        "ok": true,
        "producer": "reviewer",
        "failures": []
      }
    },
    {
      "name": "reviewer — explicit no-issues paths",
      "producer": "reviewer",
      "packet": {
        "findings": [],
        "noIssuesFoundAt": [
          "src/a.ts"
        ]
      },
      "result": {
        "ok": true,
        "producer": "reviewer",
        "failures": []
      }
    },
    {
      "name": "reviewer — explicit no-issues statement",
      "producer": "reviewer",
      "packet": {
        "noIssuesFoundStatement": "no issues found at: src/"
      },
      "result": {
        "ok": true,
        "producer": "reviewer",
        "failures": []
      }
    },
    {
      "name": "reviewer — whitespace-only statement is not a statement",
      "producer": "reviewer",
      "packet": {
        "noIssuesFoundStatement": "   "
      },
      "result": {
        "ok": false,
        "producer": "reviewer",
        "failures": [
          {
            "id": "reviewer.findings-or-explicit-clear",
            "reason": "Reviewer output rubber-stamped: empty findings and no explicit \"no issues found at: <paths>\" statement."
          }
        ]
      }
    },
    {
      "name": "reviewer — rubber stamp (empty everything)",
      "producer": "reviewer",
      "packet": {
        "findings": []
      },
      "result": {
        "ok": false,
        "producer": "reviewer",
        "failures": [
          {
            "id": "reviewer.findings-or-explicit-clear",
            "reason": "Reviewer output rubber-stamped: empty findings and no explicit \"no issues found at: <paths>\" statement."
          }
        ]
      }
    },
    {
      "name": "reviewer — empty packet",
      "producer": "reviewer",
      "packet": {},
      "result": {
        "ok": false,
        "producer": "reviewer",
        "failures": [
          {
            "id": "reviewer.findings-or-explicit-clear",
            "reason": "Reviewer output rubber-stamped: empty findings and no explicit \"no issues found at: <paths>\" statement."
          }
        ]
      }
    },
    {
      "name": "reviewer — null packet",
      "producer": "reviewer",
      "packet": null,
      "result": {
        "ok": false,
        "producer": "reviewer",
        "failures": [
          {
            "id": "reviewer.findings-or-explicit-clear",
            "reason": "Reviewer output rubber-stamped: empty findings and no explicit \"no issues found at: <paths>\" statement."
          }
        ]
      }
    },
    {
      "name": "security — threat model after brief start",
      "producer": "security",
      "packet": {
        "briefStart": "2026-01-01T00:00:00Z",
        "threatModelUpdatedAt": "2026-01-02T00:00:00Z"
      },
      "result": {
        "ok": true,
        "producer": "security",
        "failures": []
      }
    },
    {
      "name": "security — threat model exactly at brief start",
      "producer": "security",
      "packet": {
        "briefStart": "2026-01-01T00:00:00Z",
        "threatModelUpdatedAt": "2026-01-01T00:00:00Z"
      },
      "result": {
        "ok": true,
        "producer": "security",
        "failures": []
      }
    },
    {
      "name": "security — threat model retrofitted (earlier)",
      "producer": "security",
      "packet": {
        "briefStart": "2026-01-02T00:00:00Z",
        "threatModelUpdatedAt": "2026-01-01T00:00:00Z"
      },
      "result": {
        "ok": false,
        "producer": "security",
        "failures": [
          {
            "id": "security.threat-model-not-post-hoc",
            "reason": "Threat model missing or older than the contract start — likely retrofitted after implementation."
          }
        ]
      }
    },
    {
      "name": "security — unparseable dates",
      "producer": "security",
      "packet": {
        "briefStart": "not-a-date",
        "threatModelUpdatedAt": "also-not"
      },
      "result": {
        "ok": false,
        "producer": "security",
        "failures": [
          {
            "id": "security.threat-model-not-post-hoc",
            "reason": "Threat model missing or older than the contract start — likely retrofitted after implementation."
          }
        ]
      }
    },
    {
      "name": "security — missing threat model",
      "producer": "security",
      "packet": {
        "briefStart": "2026-01-01T00:00:00Z"
      },
      "result": {
        "ok": false,
        "producer": "security",
        "failures": [
          {
            "id": "security.threat-model-not-post-hoc",
            "reason": "Threat model missing or older than the contract start — likely retrofitted after implementation."
          }
        ]
      }
    },
    {
      "name": "debugger — root cause via reproduction",
      "producer": "debugger",
      "packet": {
        "rootCauseConfirmedVia": "reproduction"
      },
      "result": {
        "ok": true,
        "producer": "debugger",
        "failures": []
      }
    },
    {
      "name": "debugger — root cause via trace",
      "producer": "debugger",
      "packet": {
        "rootCauseConfirmedVia": "trace"
      },
      "result": {
        "ok": true,
        "producer": "debugger",
        "failures": []
      }
    },
    {
      "name": "debugger — root cause via test",
      "producer": "debugger",
      "packet": {
        "rootCauseConfirmedVia": "test"
      },
      "result": {
        "ok": true,
        "producer": "debugger",
        "failures": []
      }
    },
    {
      "name": "debugger — inferred is not an allowed source",
      "producer": "debugger",
      "packet": {
        "rootCauseConfirmedVia": "inference"
      },
      "result": {
        "ok": false,
        "producer": "debugger",
        "failures": [
          {
            "id": "debugger.root-cause-confirmed-via",
            "reason": "rootCauseConfirmedVia must be one of: reproduction, trace, test."
          }
        ]
      }
    },
    {
      "name": "debugger — missing field",
      "producer": "debugger",
      "packet": {},
      "result": {
        "ok": false,
        "producer": "debugger",
        "failures": [
          {
            "id": "debugger.root-cause-confirmed-via",
            "reason": "rootCauseConfirmedVia must be one of: reproduction, trace, test."
          }
        ]
      }
    },
    {
      "name": "operations — coherence check ran with a named diff",
      "producer": "operations",
      "packet": {
        "crossDocCoherenceCheckRan": true,
        "coherenceDiff": "docs/a.md +3/-1"
      },
      "result": {
        "ok": true,
        "producer": "operations",
        "failures": []
      }
    },
    {
      "name": "operations — check ran but diff is empty",
      "producer": "operations",
      "packet": {
        "crossDocCoherenceCheckRan": true,
        "coherenceDiff": ""
      },
      "result": {
        "ok": false,
        "producer": "operations",
        "failures": [
          {
            "id": "docs-keeper.cross-doc-coherence-check-ran",
            "reason": "crossDocCoherenceCheckRan must be true AND coherenceDiff must be a non-empty named diff."
          }
        ]
      }
    },
    {
      "name": "operations — truthy-but-not-true flag is rejected",
      "producer": "operations",
      "packet": {
        "crossDocCoherenceCheckRan": 1,
        "coherenceDiff": "docs/a.md"
      },
      "result": {
        "ok": false,
        "producer": "operations",
        "failures": [
          {
            "id": "docs-keeper.cross-doc-coherence-check-ran",
            "reason": "crossDocCoherenceCheckRan must be true AND coherenceDiff must be a non-empty named diff."
          }
        ]
      }
    },
    {
      "name": "operations — check did not run",
      "producer": "operations",
      "packet": {
        "coherenceDiff": "docs/a.md"
      },
      "result": {
        "ok": false,
        "producer": "operations",
        "failures": [
          {
            "id": "docs-keeper.cross-doc-coherence-check-ran",
            "reason": "crossDocCoherenceCheckRan must be true AND coherenceDiff must be a non-empty named diff."
          }
        ]
      }
    },
    {
      "name": "designer — a11y check ran",
      "producer": "designer",
      "packet": {
        "accessibilityCheckRan": true
      },
      "result": {
        "ok": true,
        "producer": "designer",
        "failures": []
      }
    },
    {
      "name": "designer — a11y check skipped",
      "producer": "designer",
      "packet": {
        "accessibilityCheckRan": false
      },
      "result": {
        "ok": false,
        "producer": "designer",
        "failures": [
          {
            "id": "designer.accessibility-check-ran",
            "reason": "accessibilityCheckRan must be true — accessibility review is a precondition for any visual deliverable."
          }
        ]
      }
    },
    {
      "name": "designer — truthy-but-not-true flag is rejected",
      "producer": "designer",
      "packet": {
        "accessibilityCheckRan": "yes"
      },
      "result": {
        "ok": false,
        "producer": "designer",
        "failures": [
          {
            "id": "designer.accessibility-check-ran",
            "reason": "accessibilityCheckRan must be true — accessibility review is a precondition for any visual deliverable."
          }
        ]
      }
    },
    {
      "name": "unregistered producer passes vacuously",
      "producer": "engineer",
      "packet": {},
      "result": {
        "ok": true,
        "producer": "engineer",
        "failures": []
      }
    },
    {
      "name": "unregistered producer with a null packet still passes",
      "producer": "engineer",
      "packet": null,
      "result": {
        "ok": true,
        "producer": "engineer",
        "failures": []
      }
    }
  ]
}
