{
  "format": "construct-workflow",
  "formatVersion": 1,
  "evals": [],
  "id": "guided-outcome",
  "title": "Produce a grounded outcome",
  "version": "1.0.1",
  "purpose": "Interpret, produce and check an outcome through the current host, with bounded gathering, checkpoints and explicit assurance. Chat delivery needs no file writer or code test runner.",
  "interactionClass": "manage",
  "inputSchema": {
    "request": "string",
    "target": "string",
    "period": "period",
    "sources": "source_ids"
  },
  "requiredInputs": [
    "request"
  ],
  "steps": [
    {
      "id": "plan",
      "title": "Turn the request into an execution plan with labeled assumptions",
      "needs": [],
      "skill": {
        "id": "intake",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_context",
        "model_review"
      ],
      "sources": [],
      "tier": "draft",
      "inputs": {
        "request": "input.request",
        "target": "input.target",
        "period": "input.period",
        "sources": "input.sources"
      },
      "outputs": [
        "plan",
        "assumptions",
        "blockers"
      ],
      "validators": [
        "schema"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 1000
      },
      "timeoutMs": 300000
    },
    {
      "id": "do",
      "title": "Do the work in this session, citing what was read",
      "needs": [
        "plan"
      ],
      "skill": null,
      "capabilities": [
        "read_project_context",
        "model_review"
      ],
      "sources": [
        {
          "kind": "directory",
          "freshness": "any",
          "required": false
        }
      ],
      "tier": "project_write",
      "inputs": {
        "request": "input.request",
        "target": "input.target",
        "period": "input.period",
        "sources": "input.sources",
        "plan": "steps.plan.plan",
        "assumptions": "steps.plan.assumptions"
      },
      "outputs": [
        "summary",
        "findings",
        "changes",
        "artifact"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "within_period",
        "named_sources_read",
        "numbers_grounded",
        "deliverable_complete",
        "no_placeholder_facts"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 1000
      },
      "timeoutMs": 1800000
    },
    {
      "id": "verify",
      "title": "Inspect the actual result and record what remains unverified",
      "needs": [
        "do"
      ],
      "skill": null,
      "capabilities": [
        "model_review",
        "run_validator"
      ],
      "sources": [],
      "tier": "observe",
      "inputs": {
        "summary": "steps.do.summary",
        "findings": "steps.do.findings",
        "changes": "steps.do.changes",
        "artifact": "steps.do.artifact"
      },
      "outputs": [
        "verification",
        "limits"
      ],
      "validators": [
        "schema",
        "evidence_refs_resolve",
        "within_period"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 0
      },
      "timeoutMs": 1200000
    }
  ],
  "triggers": [
    "manual",
    "schedule"
  ],
  "onNoData": "fail",
  "onStaleData": "proceed_flagged",
  "concurrency": "per_input",
  "dedupeKey": [
    "request",
    "target",
    "period",
    "sources"
  ],
  "cancellation": "after_step",
  "deliverable": {
    "kind": "outcome/portable",
    "schema": "outcome/portable/v1",
    "challenge": false
  },
  "proposes": [
    "lessons"
  ],
  "execution": {
    "path": "artifact",
    "checkpoints": [
      "Save the first useful artifact during the first authorized write step.",
      "Preserve partial work and unknowns before gathering or repairs exhaust their budget."
    ],
    "evidenceObligations": [
      "Support factual conclusions with admitted project evidence.",
      "Inspect the actual result against the frozen acceptance criteria.",
      "Render and inspect visual artifacts when the requested result has a visual surface."
    ],
    "maxGatherCalls": 12,
    "stopWhen": [
      "Budget exhausted: preserve partial work and remaining actions.",
      "Required permission or essential intent is unresolved."
    ],
    "assurance": "structural"
  }
}
