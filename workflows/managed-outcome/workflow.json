{
  "format": "construct-workflow",
  "formatVersion": 1,
  "evals": [],
  "id": "managed-outcome",
  "title": "Managed outcome with verification",
  "version": "2.1.1",
  "purpose": "The implementation path: plan the change, produce project files with cited evidence, run the project's own verification command, and hold the deliverable for independent semantic review. General research, decisions and chat artifacts use portable paths whose verification fits their outcome.",
  "activation": [
    "do this piece of work and hand it back",
    "manage this outcome",
    "get this done and verify it"
  ],
  "standDown": [
    "a plain question",
    "something to remember",
    "a standing outcome"
  ],
  "interactionClass": "manage",
  "inputSchema": {
    "request": "string",
    "target": "string",
    "period": "period",
    "sources": "source_ids"
  },
  "requiredInputs": [
    "request"
  ],
  "steps": [
    {
      "id": "plan",
      "title": "Turn the request into an execution plan with labeled assumptions",
      "needs": [],
      "skill": {
        "id": "intake",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_context",
        "model_review"
      ],
      "sources": [],
      "tier": "draft",
      "inputs": {
        "request": "input.request",
        "target": "input.target",
        "period": "input.period",
        "sources": "input.sources"
      },
      "outputs": [
        "plan",
        "assumptions",
        "blockers"
      ],
      "validators": [
        "schema"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 1000
      },
      "timeoutMs": 300000
    },
    {
      "id": "do",
      "title": "Do the work in this session, citing what was read",
      "needs": [
        "plan"
      ],
      "skill": null,
      "capabilities": [
        "write_project_files",
        "read_project_files",
        "model_review"
      ],
      "sources": [
        {
          "kind": "directory",
          "freshness": "any",
          "required": false
        }
      ],
      "tier": "project_write",
      "inputs": {
        "request": "input.request",
        "target": "input.target",
        "period": "input.period",
        "sources": "input.sources",
        "plan": "steps.plan.plan",
        "assumptions": "steps.plan.assumptions"
      },
      "outputs": [
        "summary",
        "findings",
        "changes",
        "artifact"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "within_period",
        "named_sources_read",
        "numbers_grounded",
        "artifacts_exist",
        "deliverable_complete",
        "no_placeholder_facts"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 1000
      },
      "timeoutMs": 1800000
    },
    {
      "id": "verify",
      "title": "Run the project's own checks, then hand back the outcome",
      "needs": [
        "do"
      ],
      "skill": null,
      "capabilities": [
        "run_tests",
        "run_validator"
      ],
      "sources": [],
      "tier": "observe",
      "inputs": {
        "summary": "steps.do.summary",
        "findings": "steps.do.findings",
        "changes": "steps.do.changes",
        "artifact": "steps.do.artifact"
      },
      "outputs": [
        "verification",
        "passed"
      ],
      "validators": [
        "evidence_refs_resolve",
        "within_period",
        "verification_result"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 1,
        "backoffMs": 0
      },
      "timeoutMs": 1200000
    }
  ],
  "triggers": [
    "manual",
    "schedule"
  ],
  "onNoData": "fail",
  "onStaleData": "proceed_flagged",
  "concurrency": "per_input",
  "dedupeKey": [
    "request",
    "target",
    "period",
    "sources"
  ],
  "cancellation": "after_step",
  "deliverable": {
    "kind": "outcome/managed",
    "schema": "outcome/managed/v2",
    "challenge": false
  },
  "proposes": [
    "lessons"
  ],
  "execution": {
    "path": "implementation",
    "checkpoints": [
      "Save the first useful artifact during the first authorized write step.",
      "Preserve partial work and unknowns before gathering or repairs exhaust their budget."
    ],
    "evidenceObligations": [
      "Cite actual reads with provenance.",
      "Run the project validation path and inspect the intended outcome."
    ],
    "maxGatherCalls": 12,
    "stopWhen": [
      "Budget exhausted: preserve partial work and remaining actions.",
      "Required permission or essential intent is unresolved."
    ],
    "assurance": "independent_review"
  }
}
