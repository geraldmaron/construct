{
  "format": "construct-workflow",
  "formatVersion": 1,
  "id": "prd-authoring",
  "title": "Write a PRD",
  "version": "1.1.0",
  "purpose": "Write a product requirements document grounded in the project's sources and work items, in the project's template when one is named; surface conflicts and unknowns instead of resolving them silently; challenge the draft before handing it back.",
  "activation": [
    "write a PRD",
    "spec out this feature from the tickets and research",
    "draft the product requirements"
  ],
  "standDown": [
    "review this PRD",
    "should we build this"
  ],
  "interactionClass": "manage",
  "inputSchema": {
    "request": "string",
    "target": "string",
    "template": "string"
  },
  "requiredInputs": [
    "request",
    "target"
  ],
  "steps": [
    {
      "id": "gather",
      "title": "Read the governing material, sources, and work items; name every conflict between them",
      "needs": [],
      "skill": {
        "id": "context-mapping",
        "range": "^0.4.0"
      },
      "capabilities": [
        "read_project_context",
        "read_project_files"
      ],
      "sources": [
        {
          "kind": "directory",
          "freshness": "any",
          "required": false
        },
        {
          "kind": "jira",
          "freshness": "any",
          "required": false
        }
      ],
      "tier": "observe",
      "inputs": {
        "request": "input.request",
        "template": "input.template"
      },
      "outputs": [
        "summary",
        "findings",
        "material",
        "conflicts",
        "unknowns"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "superseded_acknowledged",
        "conflicts_declared",
        "settled_not_contradicted",
        "deliverable_complete"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 600000
    },
    {
      "id": "draft",
      "title": "Write the PRD to the target file, grounded in what was gathered",
      "needs": [
        "gather"
      ],
      "skill": {
        "id": "requirements-structuring",
        "range": "^0.5.0"
      },
      "capabilities": [
        "read_project_files",
        "write_project_files",
        "model_review"
      ],
      "sources": [],
      "tier": "project_write",
      "inputs": {
        "request": "input.request",
        "target": "input.target",
        "template": "input.template",
        "material": "steps.gather.material",
        "conflicts": "steps.gather.conflicts",
        "unknowns": "steps.gather.unknowns"
      },
      "outputs": [
        "summary",
        "findings",
        "artifact",
        "derivations"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "evidence_recorded",
        "superseded_acknowledged",
        "artifacts_exist",
        "numbers_grounded",
        "template_conformance",
        "settled_not_contradicted",
        "deliverable_complete"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 1800000
    },
    {
      "id": "challenge",
      "title": "Challenge the PRD: unsupported claims, silently resolved conflicts, invented owners or decisions",
      "needs": [
        "draft",
        "gather"
      ],
      "skill": {
        "id": "adversarial-review",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_files",
        "model_review"
      ],
      "sources": [],
      "tier": "draft",
      "inputs": {
        "artifact": "steps.draft.artifact",
        "conflicts": "steps.gather.conflicts",
        "unknowns": "steps.gather.unknowns"
      },
      "outputs": [
        "verdict",
        "findings",
        "summary"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "no_uncited_material_findings",
        "deliverable_complete"
      ],
      "loadBearing": true,
      "challenge": true,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 900000
    },
    {
      "id": "record",
      "title": "Record the result and hand it back",
      "needs": [
        "challenge",
        "draft"
      ],
      "skill": null,
      "capabilities": [
        "write_project_context"
      ],
      "sources": [],
      "tier": "project_write",
      "inputs": {
        "artifact": "steps.draft.artifact",
        "verdict": "steps.challenge.verdict"
      },
      "outputs": [
        "artifact",
        "verdict"
      ],
      "validators": [
        "schema",
        "artifacts_exist"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 1,
        "backoffMs": 0
      },
      "timeoutMs": 30000
    }
  ],
  "triggers": [
    "manual"
  ],
  "onNoData": "block",
  "onStaleData": "proceed_flagged",
  "concurrency": "per_input",
  "dedupeKey": [
    "target"
  ],
  "cancellation": "after_step",
  "deliverable": {
    "kind": "document/prd",
    "schema": "document/prd/v1",
    "challenge": true
  },
  "proposes": [
    "lessons"
  ],
  "evals": []
}
