{
  "format": "construct-workflow",
  "formatVersion": 1,
  "id": "research-brief",
  "title": "Research a question",
  "version": "1.3.2",
  "purpose": "Answer a question from the project's sources and the web the host can read, with every finding cited, sources that disagree set side by side, figures traced to where they come from, and what could not be established said plainly; challenged before it is handed back.",
  "interactionClass": "manage",
  "inputSchema": {
    "question": "string",
    "scope": "string",
    "target": "string",
    "period": "period",
    "sources": "source_ids"
  },
  "requiredInputs": [
    "question"
  ],
  "steps": [
    {
      "id": "gather",
      "title": "Find and read what bears on the question, inside the project and out; note where sources disagree",
      "needs": [],
      "skill": {
        "id": "investigative-research",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_context",
        "read_project_files",
        "read_source"
      ],
      "sources": [
        {
          "kind": "directory",
          "freshness": "any",
          "required": false
        },
        {
          "kind": "jira",
          "freshness": "any",
          "required": false
        },
        {
          "kind": "docs",
          "freshness": "any",
          "required": false
        }
      ],
      "tier": "observe",
      "inputs": {
        "question": "input.question",
        "scope": "input.scope",
        "target": "input.target",
        "period": "input.period",
        "sources": "input.sources"
      },
      "outputs": [
        "summary",
        "findings",
        "conflicts",
        "unknowns"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "within_period",
        "named_sources_read",
        "conflicts_declared",
        "deliverable_complete",
        "reference_coverage"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 1800000
    },
    {
      "id": "synthesize",
      "title": "Save the requested draft, then answer what holds, how sure, what it rests on and what remains unknown",
      "needs": [
        "gather"
      ],
      "skill": {
        "id": "investigative-research",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_files",
        "write_project_files",
        "model_review"
      ],
      "sources": [],
      "tier": "project_write",
      "inputs": {
        "question": "input.question",
        "target": "input.target",
        "findings": "steps.gather.findings",
        "conflicts": "steps.gather.conflicts",
        "unknowns": "steps.gather.unknowns"
      },
      "outputs": [
        "summary",
        "findings",
        "confidence",
        "unknowns",
        "derivations",
        "artifact"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "excerpts_match",
        "within_period",
        "sources_diverse",
        "numbers_grounded",
        "superseded_acknowledged",
        "no_uncited_material_findings",
        "settled_not_contradicted",
        "deliverable_complete"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 1800000
    },
    {
      "id": "challenge",
      "title": "Challenge the answer: single-source claims, stale or superseded sources, figures without a trail, conclusions the evidence does not reach",
      "needs": [
        "synthesize"
      ],
      "skill": {
        "id": "adversarial-review",
        "range": "^0.3.0"
      },
      "capabilities": [
        "read_project_files",
        "model_review"
      ],
      "sources": [],
      "tier": "draft",
      "inputs": {
        "summary": "steps.synthesize.summary",
        "findings": "steps.synthesize.findings"
      },
      "outputs": [
        "verdict",
        "findings",
        "summary"
      ],
      "validators": [
        "citations_present",
        "evidence_refs_resolve",
        "within_period",
        "no_uncited_material_findings",
        "deliverable_complete"
      ],
      "loadBearing": true,
      "challenge": true,
      "retry": {
        "maxAttempts": 3,
        "backoffMs": 1000
      },
      "timeoutMs": 900000
    },
    {
      "id": "record",
      "title": "Record the answer and hand it back",
      "needs": [
        "challenge",
        "synthesize"
      ],
      "skill": null,
      "capabilities": [
        "write_project_context"
      ],
      "sources": [],
      "tier": "project_write",
      "inputs": {
        "summary": "steps.synthesize.summary",
        "verdict": "steps.challenge.verdict",
        "artifact": "steps.synthesize.artifact"
      },
      "outputs": [
        "summary",
        "verdict"
      ],
      "validators": [
        "schema"
      ],
      "loadBearing": true,
      "challenge": false,
      "retry": {
        "maxAttempts": 1,
        "backoffMs": 0
      },
      "timeoutMs": 30000
    }
  ],
  "triggers": [
    "manual"
  ],
  "onNoData": "block",
  "onStaleData": "proceed_flagged",
  "concurrency": "per_input",
  "dedupeKey": [
    "question",
    "period",
    "sources"
  ],
  "cancellation": "after_step",
  "deliverable": {
    "kind": "research/brief",
    "schema": "research/brief/v1",
    "challenge": true
  },
  "proposes": [
    "lessons"
  ],
  "execution": {
    "path": "research",
    "checkpoints": [
      "Save the first useful artifact during the first authorized write step.",
      "Preserve partial work and unknowns before gathering or repairs exhaust their budget."
    ],
    "evidenceObligations": [
      "Support factual conclusions with admitted project evidence.",
      "Inspect the actual result against the frozen acceptance criteria.",
      "Render and inspect visual artifacts when the requested result has a visual surface."
    ],
    "maxGatherCalls": 12,
    "stopWhen": [
      "Budget exhausted: preserve partial work and remaining actions.",
      "Required permission or essential intent is unresolved."
    ],
    "assurance": "structural"
  }
}
